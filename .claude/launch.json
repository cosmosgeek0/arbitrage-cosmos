{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cosmos",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/dist/index.js"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173,
      "autoPort": false,
      "env": {
        "VITE_PORT": "5173",
        "VITE_API_PROXY_TARGET": "http://127.0.0.1:8080"
      }
    }
  ]
}
