# Copy this file to `.env` on the SERVER/local machine only. Never commit `.env`.
# Never put keys in the frontend. Never paste secrets into chat or GitHub.
#
# Create a Binance SYSTEM-GENERATED HMAC API key with:
#   - Enable Reading            : ON
#   - Enable Spot & Margin Trading : OFF   (recommended default posture)
#   - Enable Withdrawals        : OFF
#   - Enable Universal Transfer : OFF
#   - Optionally restrict access to your current IP
# Binance shows the secret only once — save it immediately.
# Placeholders only below — put the real values in `.env`, then restart the server.

BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_read_only_api_secret_here

# Public egress IP identities shown in the Binance API Keys posture panel.
# Keep these aligned with the IP restrictions configured on Binance; they are
# not credentials and do not grant access by themselves.
BINANCE_KEY_IPS=your_read_only_key_egress_ip
BINANCE_FULL_KEY_IPS=your_full_key_egress_ip

# The origin is loopback-only by default. Set HOST=0.0.0.0 only behind an
# authenticated private ingress after reviewing the deployment boundary.
# HOST=127.0.0.1
# PORT=8080
# DATA_DIR=./data

# AWS Runner Control (optional, server-side only).
# The UI is fail-closed until all target fields are valid. Use an SSM-managed
# instance and a least-privilege IAM role. Prefer a custom restrictive Command
# document over unrestricted AWS-RunShellScript in production.
# Never place AWS access keys, runner source, or secret values in the browser.
# AWS_CONTROL_REGION=ap-south-1
# AWS_CONTROL_INSTANCE_ID=i-0123456789abcdef0
# AWS_CONTROL_RUNNER_PATH=/opt/arbitrage/runner.ts
# AWS_CONTROL_WORKDIR=/opt/arbitrage
# AWS_CONTROL_SERVICE=arbitrage-runner.service
# AWS_CONTROL_DOCUMENT=AWS-RunShellScript
# AWS_CONTROL_VALIDATE_COMMAND=npm run build

# Production mutation access requires a valid Cloudflare Access application JWT
# with this audience and a verified email matching the operator below.
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your_access_application_audience_tag
# CONTROL_ROOM_OPERATOR_EMAIL=operator@example.com
# AWS_CONTROL_OPERATOR_EMAIL remains a compatibility fallback for the same identity.
# AWS_CONTROL_OPERATOR_EMAIL=operator@example.com

# Optional AWS notification intake (server-side only). When set, EventBridge
# API Destinations may POST selected EC2, CloudWatch, or AWS Health events to
# /api/notifications/ingest/aws with `Authorization: Bearer <this token>`.
# Generate a long random value; never place it in frontend code.
# NOTIFICATION_AWS_INGEST_TOKEN=replace_with_a_long_random_server_token

# Localhost remains available for local operator testing without a Cloudflare
# token. Non-local requests fail closed if any Access setting is absent/invalid.
