{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ip-assurance-diagnostic-worker-view-v1",
  "title": "Render-neutral diagnostic worker cockpit projection",
  "$defs": {
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,160}$" },
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Utc": { "type": "integer", "minimum": 1262304000000, "maximum": 4102444800000 },
    "NullableUtc": { "anyOf": [{ "$ref": "#/$defs/Utc" }, { "type": "null" }] },
    "NullableId": { "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }] },
    "NullableHash": { "anyOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] },
    "NullableInteger": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "IdList": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
    "ReasonList": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" } },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "disposition", "reasonCodes"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "disposition": { "$ref": "#/$defs/Id" },
        "reasonCodes": { "$ref": "#/$defs/ReasonList" }
      }
    },
    "EvidenceStatus": { "enum": ["PASS", "FAIL", "UNKNOWN"] }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "revision", "evaluatedAtMs", "projectionId", "owner", "dependencies", "freshness",
    "sourceRealm", "configRevision", "schemaRevision", "buildRevision", "lastErrorFingerprint", "supportedControls",
    "capitalRelevance", "sourceState", "wiringState", "planeAvailability", "assuranceStatus", "operatingDisposition",
    "productReadinessImpact", "tradeReadinessImpact", "executionAuthorityEffect", "desiredState", "observedLifecycle",
    "capability", "heartbeatAtMs", "lastMeaningfulAdvanceAtMs", "queueDepth", "dropCount", "restartGeneration",
    "operatorAttentionRequired", "provider", "workloadIdentity", "sandbox", "run", "budget", "proposalAssurance",
    "trace", "selfCorrection", "repairEvidence", "corpusGovernance", "killControl", "providerEvaluation",
    "rootBlocker", "reasonCodes", "safeNextAction"
  ],
  "properties": {
    "schema": { "const": "DiagnosticWorkerViewV1" },
    "version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "evaluatedAtMs": { "$ref": "#/$defs/Utc" },
    "projectionId": { "$ref": "#/$defs/Id" },
    "owner": { "$ref": "#/$defs/Id" },
    "dependencies": { "$ref": "#/$defs/IdList" },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["state", "ageMs", "evaluatedAtMs", "maxAgeMs"], "properties": { "state": { "enum": ["FRESH", "STALE", "UNKNOWN"] }, "ageMs": { "$ref": "#/$defs/NullableInteger" }, "evaluatedAtMs": { "$ref": "#/$defs/NullableUtc" }, "maxAgeMs": { "$ref": "#/$defs/NullableInteger" } } },
    "sourceRealm": { "enum": ["FIXTURE", "REPLAY", "UNKNOWN"] },
    "configRevision": { "$ref": "#/$defs/Id" },
    "schemaRevision": { "$ref": "#/$defs/Id" },
    "buildRevision": { "$ref": "#/$defs/Id" },
    "lastErrorFingerprint": { "$ref": "#/$defs/NullableId" },
    "supportedControls": { "$ref": "#/$defs/IdList" },
    "capitalRelevance": { "const": "NONE" },
    "sourceState": { "enum": ["SYNTHETIC_ONLY", "NOT_CONFIGURED"] },
    "wiringState": { "anyOf": [{ "const": "WIRED_FIXTURE" }, { "type": "string", "pattern": "^PENDING_BACKEND:[A-Za-z0-9_.:-]{1,128}$" }] },
    "planeAvailability": { "enum": ["AVAILABLE", "UNAVAILABLE", "NOT_CONFIGURED"] },
    "assuranceStatus": { "$ref": "#/$defs/EvidenceStatus" },
    "operatingDisposition": { "enum": ["ELIGIBLE_FOR_STUB_EVIDENCE", "BLOCKED", "UNAVAILABLE", "NOT_CONFIGURED"] },
    "productReadinessImpact": { "const": "NONE" },
    "tradeReadinessImpact": { "const": "NONE" },
    "executionAuthorityEffect": { "const": "NONE" },
    "desiredState": { "enum": ["RUNNING", "STOPPED", "PAUSED"] },
    "observedLifecycle": { "enum": ["STOPPED", "START_REQUESTED", "STARTING", "WARMING", "READY", "DEGRADED", "PAUSED", "DRAINING", "RECONCILING", "RECOVERY_REQUIRED", "BLOCKED", "FAILED", "STOPPING"] },
    "capability": { "enum": ["SYNTHETIC", "NOT_CONFIGURED", "UNAVAILABLE", "UNKNOWN"] },
    "heartbeatAtMs": { "$ref": "#/$defs/NullableUtc" },
    "lastMeaningfulAdvanceAtMs": { "$ref": "#/$defs/NullableUtc" },
    "queueDepth": { "$ref": "#/$defs/NullableInteger" },
    "dropCount": { "$ref": "#/$defs/NullableInteger" },
    "restartGeneration": { "$ref": "#/$defs/NullableInteger" },
    "operatorAttentionRequired": { "type": "boolean" },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "providerId", "modelId", "modelVersion", "posture", "policyRevision"],
      "properties": {
        "mode": { "enum": ["DETERMINISTIC_STUB", "UNKNOWN", "NOT_CONFIGURED"] },
        "providerId": { "$ref": "#/$defs/NullableId" },
        "modelId": { "$ref": "#/$defs/NullableId" },
        "modelVersion": { "$ref": "#/$defs/NullableId" },
        "posture": { "enum": ["AVAILABLE", "OUTAGE", "COST_EXHAUSTED", "UNKNOWN", "NOT_CONFIGURED"] },
        "policyRevision": { "$ref": "#/$defs/NullableId" }
      }
    },
    "workloadIdentity": { "type": "object", "additionalProperties": false, "required": ["status", "state", "generation", "identityRef", "expiresAtMs", "rotationDueAtMs"], "properties": { "status": { "$ref": "#/$defs/EvidenceStatus" }, "state": { "$ref": "#/$defs/Id" }, "generation": { "$ref": "#/$defs/NullableInteger" }, "identityRef": { "$ref": "#/$defs/NullableId" }, "expiresAtMs": { "$ref": "#/$defs/NullableUtc" }, "rotationDueAtMs": { "$ref": "#/$defs/NullableUtc" } } },
    "sandbox": { "type": "object", "additionalProperties": false, "required": ["status", "disposition", "bindingId", "permissionLevel", "capabilities", "blockerCodes"], "properties": { "status": { "$ref": "#/$defs/EvidenceStatus" }, "disposition": { "$ref": "#/$defs/Id" }, "bindingId": { "$ref": "#/$defs/NullableId" }, "permissionLevel": { "$ref": "#/$defs/NullableId" }, "capabilities": { "$ref": "#/$defs/IdList" }, "blockerCodes": { "$ref": "#/$defs/ReasonList" } } },
    "run": { "type": "object", "additionalProperties": false, "required": ["runId", "incidentId", "correlationId", "deadlineAtMs", "disposition", "evidenceDigestCount", "retrievalCount", "redactionState", "permissionLevel"], "properties": { "runId": { "$ref": "#/$defs/NullableId" }, "incidentId": { "$ref": "#/$defs/NullableId" }, "correlationId": { "$ref": "#/$defs/NullableId" }, "deadlineAtMs": { "$ref": "#/$defs/NullableUtc" }, "disposition": { "$ref": "#/$defs/Id" }, "evidenceDigestCount": { "$ref": "#/$defs/NullableInteger" }, "retrievalCount": { "$ref": "#/$defs/NullableInteger" }, "redactionState": { "$ref": "#/$defs/EvidenceStatus" }, "permissionLevel": { "$ref": "#/$defs/NullableId" } } },
    "budget": { "type": "object", "additionalProperties": false, "required": ["callsUsed", "callsLimit", "tokensUsed", "tokensLimit", "costMicrounitsUsed", "costMicrounitsLimit", "latencyMs", "latencyLimitMs"], "properties": { "callsUsed": { "$ref": "#/$defs/NullableInteger" }, "callsLimit": { "$ref": "#/$defs/NullableInteger" }, "tokensUsed": { "$ref": "#/$defs/NullableInteger" }, "tokensLimit": { "$ref": "#/$defs/NullableInteger" }, "costMicrounitsUsed": { "$ref": "#/$defs/NullableInteger" }, "costMicrounitsLimit": { "$ref": "#/$defs/NullableInteger" }, "latencyMs": { "$ref": "#/$defs/NullableInteger" }, "latencyLimitMs": { "$ref": "#/$defs/NullableInteger" } } },
    "proposalAssurance": { "type": "object", "additionalProperties": false, "required": ["proposalId", "approvalRef", "approvalStatus", "verifierId", "verifierStatus", "postconditionStatus", "quietPeriodStatus"], "properties": { "proposalId": { "$ref": "#/$defs/NullableId" }, "approvalRef": { "$ref": "#/$defs/NullableId" }, "approvalStatus": { "enum": ["APPROVED", "REJECTED", "EXPIRED", "NOT_REQUIRED", "UNKNOWN", "NOT_CONFIGURED"] }, "verifierId": { "$ref": "#/$defs/NullableId" }, "verifierStatus": { "$ref": "#/$defs/EvidenceStatus" }, "postconditionStatus": { "$ref": "#/$defs/EvidenceStatus" }, "quietPeriodStatus": { "$ref": "#/$defs/EvidenceStatus" } } },
    "trace": { "type": "object", "additionalProperties": false, "required": ["privacy", "lastAppendSequence", "lastChainDigest", "retentionOwnerId", "independentEvidencePass"], "properties": { "privacy": { "$ref": "#/$defs/Decision" }, "lastAppendSequence": { "$ref": "#/$defs/NullableInteger" }, "lastChainDigest": { "$ref": "#/$defs/NullableHash" }, "retentionOwnerId": { "$ref": "#/$defs/NullableId" }, "independentEvidencePass": { "type": "boolean" } } },
    "selfCorrection": { "type": "object", "additionalProperties": false, "required": ["declaredClass", "derivedClass", "effectiveClass", "promotion", "operationalActionAllowed"], "properties": { "declaredClass": { "anyOf": [{ "enum": ["A", "B", "C", "D"] }, { "type": "null" }] }, "derivedClass": { "anyOf": [{ "enum": ["A", "B", "C", "D", "UNKNOWN"] }, { "type": "null" }] }, "effectiveClass": { "anyOf": [{ "enum": ["A", "B", "C", "D", "UNKNOWN"] }, { "type": "null" }] }, "promotion": { "$ref": "#/$defs/Decision" }, "operationalActionAllowed": { "const": false } } },
    "repairEvidence": { "type": "object", "additionalProperties": false, "required": ["evaluation", "eligibleForCanonicalRecoveryReadback", "postconditionStatus", "quietPeriodStatus", "verifierId", "verifierStatus", "recoveryDeclared"], "properties": { "evaluation": { "$ref": "#/$defs/Decision" }, "eligibleForCanonicalRecoveryReadback": { "type": "boolean" }, "postconditionStatus": { "$ref": "#/$defs/EvidenceStatus" }, "quietPeriodStatus": { "$ref": "#/$defs/EvidenceStatus" }, "verifierId": { "$ref": "#/$defs/NullableId" }, "verifierStatus": { "$ref": "#/$defs/EvidenceStatus" }, "recoveryDeclared": { "const": false } } },
    "corpusGovernance": { "$ref": "#/$defs/Decision" },
    "killControl": { "type": "object", "additionalProperties": false, "required": ["controlId", "desiredState", "effectiveState", "blockingState", "wiringState", "pendingCommandId", "selfReenableAllowed", "retentionContinuesWhenEngaged"], "properties": { "controlId": { "$ref": "#/$defs/Id" }, "desiredState": { "enum": ["ENGAGED", "DISENGAGED", "UNKNOWN"] }, "effectiveState": { "enum": ["ENGAGED", "DISENGAGED", "UNKNOWN"] }, "blockingState": { "enum": ["ENGAGED", "DISENGAGED", "UNKNOWN"] }, "wiringState": { "type": "string", "pattern": "^PENDING_BACKEND:[A-Za-z0-9_.:-]{1,128}$" }, "pendingCommandId": { "$ref": "#/$defs/Id" }, "selfReenableAllowed": { "const": false }, "retentionContinuesWhenEngaged": { "const": true } } },
    "providerEvaluation": { "$ref": "#/$defs/Decision" },
    "rootBlocker": { "$ref": "#/$defs/NullableId" },
    "reasonCodes": { "$ref": "#/$defs/ReasonList" },
    "safeNextAction": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
