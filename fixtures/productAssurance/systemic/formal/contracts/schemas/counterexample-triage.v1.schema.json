{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cosmos:ip-assurance:s3:counterexample-triage:v1",
  "title": "IP-ASSURANCE S3 counterexample triage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "triageId", "modelId", "modelVersion", "modelContentSha256",
    "modelProfile", "profileProvenance", "propertyId", "checkerId", "checkerVersion",
    "bounds", "assumptions", "trace", "traceSha256", "firstBadIndex",
    "disposition", "evidenceRefs", "reachabilityBasis",
    "implementationReplay", "reviewer", "reviewedAtMs"
  ],
  "properties": {
    "schemaVersion": { "const": "ip-assurance.s3.counterexample-triage.v1" },
    "triageId": { "$ref": "#/$defs/id" },
    "modelId": { "$ref": "#/$defs/id" },
    "modelVersion": { "$ref": "#/$defs/text80" },
    "modelContentSha256": { "$ref": "#/$defs/sha256" },
    "modelProfile": { "$ref": "#/$defs/id" },
    "profileProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceRef", "graphFingerprint", "evidenceRefs"],
      "properties": {
        "kind": { "enum": ["PACKET_NEGATIVE_CONTROL", "CANONICAL_CHECKER_COUNTEREXAMPLE"] },
        "sourceRef": { "$ref": "#/$defs/text500" },
        "graphFingerprint": { "$ref": "#/$defs/graphFingerprint" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefs" }
      }
    },
    "propertyId": { "$ref": "#/$defs/id" },
    "checkerId": { "$ref": "#/$defs/id" },
    "checkerVersion": { "$ref": "#/$defs/text80" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxStates", "maxTransitions", "maxDepth"],
      "properties": {
        "maxStates": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxTransitions": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "assumptions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/text500" } },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "loopStart"],
      "properties": {
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 1024,
          "prefixItems": [
            {
              "type": "object",
              "properties": { "actionId": { "const": "INIT" } },
              "required": ["actionId"]
            }
          ],
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["index", "actionId", "state"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "actionId": { "$ref": "#/$defs/actionId" },
              "state": { "type": "object" }
            }
          }
        },
        "loopStart": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "traceSha256": { "$ref": "#/$defs/sha256" },
    "firstBadIndex": { "type": "integer", "minimum": 0 },
    "disposition": {
      "enum": [
        "IMPLEMENTATION_RELEVANT_VALIDATED",
        "SPECIFICATION_MODEL_DEFECT",
        "ASSUMPTION_VIOLATION",
        "SPURIOUS_UNREACHABLE_UNDER_IMPLEMENTATION_CONSTRAINTS",
        "UNRESOLVED"
      ]
    },
    "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefs" },
    "reachabilityBasis": { "$ref": "#/$defs/text1000" },
    "implementationReplay": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "implementationReleaseSha", "harness", "evidenceRefs"],
      "properties": {
        "status": { "enum": ["NOT_RUN", "REPRODUCED", "NOT_REPRODUCED", "NOT_APPLICABLE"] },
        "implementationReleaseSha": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "harness": { "oneOf": [{ "$ref": "#/$defs/text500" }, { "type": "null" }] },
        "evidenceRefs": { "$ref": "#/$defs/refs" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "REPRODUCED" } } },
          "then": {
            "properties": {
              "implementationReleaseSha": { "$ref": "#/$defs/gitSha" },
              "harness": { "$ref": "#/$defs/text500" },
              "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefs" }
            }
          }
        }
      ]
    },
    "reviewer": { "$ref": "#/$defs/text160" },
    "reviewedAtMs": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profileProvenance": {
            "properties": { "kind": { "const": "CANONICAL_CHECKER_COUNTEREXAMPLE" } },
            "required": ["kind"]
          }
        },
        "required": ["profileProvenance"]
      },
      "then": { "properties": { "modelProfile": { "const": "CANONICAL" } } }
    },
    {
      "if": { "properties": { "modelProfile": { "const": "CANONICAL" } }, "required": ["modelProfile"] },
      "then": {
        "properties": {
          "profileProvenance": {
            "properties": { "kind": { "const": "CANONICAL_CHECKER_COUNTEREXAMPLE" } },
            "required": ["kind"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Z0-9][A-Z0-9._:-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "graphFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "actionId": { "type": "string", "minLength": 2, "maxLength": 96, "pattern": "^[A-Z][A-Z0-9_]{1,95}$" },
    "text80": { "type": "string", "minLength": 1, "maxLength": 80 },
    "text96": { "type": "string", "minLength": 1, "maxLength": 96 },
    "text160": { "type": "string", "minLength": 1, "maxLength": 160 },
    "text500": { "type": "string", "minLength": 1, "maxLength": 500 },
    "text1000": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "refs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/text500" } },
    "nonEmptyRefs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/text500" } }
  }
}
