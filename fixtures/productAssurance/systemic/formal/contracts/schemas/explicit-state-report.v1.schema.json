{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cosmos:ip-assurance:s3:explicit-state-report:v1",
  "title": "IP-ASSURANCE S3 deterministic explicit-state report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "checker", "modelId", "modelVersion", "profile", "authority",
    "assumptions", "declaredBounds", "executedBounds", "overallStatus", "exploration",
    "properties", "representativeTraces", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "ip-assurance.s3.explicit-state-report.v1" },
    "checker": {
      "type": "object", "additionalProperties": false,
      "required": ["checkerId", "checkerVersion", "algorithm"],
      "properties": {
        "checkerId": { "const": "NODE_DETERMINISTIC_EXPLICIT_STATE" },
        "checkerVersion": { "const": "1.0.0" },
        "algorithm": { "const": "CANONICAL_SORTED_BFS_WITH_FAIR_SCC" }
      }
    },
    "modelId": { "$ref": "#/$defs/id" },
    "modelVersion": { "$ref": "#/$defs/text80" },
    "profile": { "$ref": "#/$defs/text96" },
    "authority": { "const": "SUPPORTING_EVIDENCE_ONLY" },
    "assumptions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "$ref": "#/$defs/text500" }
    },
    "declaredBounds": { "$ref": "#/$defs/bounds" },
    "executedBounds": { "$ref": "#/$defs/bounds" },
    "overallStatus": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "exploration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "states", "transitions", "maxDepthReached", "terminalStates",
        "deadlocks", "graphFingerprint", "truncatedReasons", "actionCoverage"
      ],
      "properties": {
        "status": { "enum": ["EXHAUSTIVE", "TRUNCATED"] },
        "states": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "transitions": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "maxDepthReached": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "terminalStates": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "deadlocks": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "graphFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "truncatedReasons": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/text160" }
        },
        "actionCoverage": {
          "type": "array", "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["actionId", "count"],
            "properties": {
              "actionId": { "$ref": "#/$defs/actionId" },
              "count": { "type": "integer", "minimum": 1, "maximum": 10000000 }
            }
          }
        }
      }
    },
    "properties": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "$ref": "#/$defs/property" }
    },
    "representativeTraces": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["terminalClass", "steps"],
        "properties": {
          "terminalClass": { "$ref": "#/$defs/actionId" },
          "steps": { "$ref": "#/$defs/steps" }
        }
      }
    },
    "limitations": {
      "type": "array", "maxItems": 64,
      "items": { "$ref": "#/$defs/text1000" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "overallStatus": { "const": "PASS" } } },
      "then": {
        "properties": {
          "exploration": { "properties": { "status": { "const": "EXHAUSTIVE" } } },
          "properties": { "items": { "properties": { "status": { "const": "PASS" } } } }
        }
      }
    },
    {
      "if": { "properties": { "overallStatus": { "const": "FAIL" } } },
      "then": { "properties": { "properties": { "contains": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Z0-9][A-Z0-9._:-]+$" },
    "actionId": { "type": "string", "minLength": 2, "maxLength": 96, "pattern": "^[A-Z][A-Z0-9_]+$" },
    "text80": { "type": "string", "minLength": 1, "maxLength": 80 },
    "text96": { "type": "string", "minLength": 1, "maxLength": 96 },
    "text160": { "type": "string", "minLength": 1, "maxLength": 160 },
    "text500": { "type": "string", "minLength": 1, "maxLength": 500 },
    "text1000": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["maxStates", "maxTransitions", "maxDepth"],
      "properties": {
        "maxStates": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxTransitions": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "actionId", "state"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "actionId": { "$ref": "#/$defs/actionId" },
        "state": { "type": "object" }
      }
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": { "$ref": "#/$defs/step" }
    },
    "livenessTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["loopStart", "steps"],
      "properties": {
        "loopStart": { "type": ["integer", "null"], "minimum": 0 },
        "steps": { "$ref": "#/$defs/steps" }
      }
    },
    "property": {
      "type": "object", "additionalProperties": false,
      "required": ["propertyId", "kind", "status", "detail", "trace"],
      "properties": {
        "propertyId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["SAFETY", "LIVENESS"] },
        "status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "detail": { "oneOf": [{ "$ref": "#/$defs/text1000" }, { "type": "null" }] },
        "trace": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/steps" },
            { "$ref": "#/$defs/livenessTrace" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } } },
          "then": { "properties": { "trace": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "FAIL" } } },
          "then": { "properties": { "trace": { "not": { "type": "null" } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "SAFETY" } } },
          "then": { "properties": { "trace": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/steps" }] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "LIVENESS" } } },
          "then": { "properties": { "trace": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/livenessTrace" }] } } }
        }
      ]
    }
  }
}
