{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ip-assurance:s5:observability:reason-code-registry:v1",
  "title": "Bounded conservation stage reason-code registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "registryRevision", "registrySha256", "entries"],
  "properties": {
    "schemaVersion": { "const": "reason-code-registry.v1" },
    "registryId": { "$ref": "#/$defs/identifier" },
    "registryRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "registrySha256": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "allowedContexts"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "allowedContexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["TRANSITION", "DISPOSITION"] }
        }
      }
    }
  }
}
