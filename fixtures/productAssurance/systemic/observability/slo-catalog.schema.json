{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ip-assurance:s5:observability:slo-catalog:v1",
  "title": "Synthetic evidence-only SLO and historical metric catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogRevision",
    "catalogSha256",
    "releaseSha",
    "generatedAtMs",
    "truthLabel",
    "authority",
    "dataMode",
    "evidenceOnly",
    "effectPolicy",
    "slos",
    "historicalMetricRegistry"
  ],
  "properties": {
    "schemaVersion": { "const": "slo-catalog.v1" },
    "catalogId": { "$ref": "#/$defs/identifier" },
    "catalogRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "releaseSha": { "$ref": "#/$defs/releaseSha" },
    "generatedAtMs": { "$ref": "#/$defs/utcMillis" },
    "truthLabel": { "const": "SYNTHETIC_ONLY" },
    "authority": { "const": "SYNTHETIC_TEST" },
    "dataMode": { "const": "SYNTHETIC" },
    "evidenceOnly": { "const": true },
    "effectPolicy": { "$ref": "#/$defs/effectPolicy" },
    "slos": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/sloCatalogEntry" }
    },
    "historicalMetricRegistry": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": { "$ref": "#/$defs/historicalMetricEntry" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "releaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sloCategory": {
      "enum": [
        "SOURCE_COHERENCE_AGE",
        "QUEUE_BACKPRESSURE",
        "PROCESSING_COMMAND_LATENCY",
        "AMBIGUITY_DURATION",
        "RECONCILIATION_LAG",
        "EVIDENCE_EXPIRY",
        "TELEMETRY_COMPLETENESS",
        "RECOVERY_VERIFICATION",
        "SENTINEL_PAGING_DELIVERY",
        "RESTART_RTO_RPO",
        "RESOURCE_BUDGET"
      ]
    },
    "metricFamily": {
      "enum": [
        "SOURCE_AGE_PERCENTILES",
        "PROCESSING_AGE_PERCENTILES",
        "CROSS_SOURCE_SKEW",
        "QUEUE_DEPTH_BACKPRESSURE",
        "DROPPED_COALESCED_EVENTS",
        "RECONCILIATION_GAP",
        "AMBIGUITY_DURATION",
        "AUTOMATIC_RECOVERY_RESULT_RATE",
        "EXECUTION_COST",
        "SLIPPAGE",
        "FUNDING",
        "BORROW_INTEREST",
        "MARKET_IMPACT",
        "INCIDENT_FREQUENCY",
        "RECURRING_FAILED_INVARIANTS",
        "CPU_BUDGET",
        "MEMORY_BUDGET",
        "DISK_BUDGET",
        "WAL_BUDGET",
        "API_RATE_BUDGET",
        "TELEMETRY_BUDGET",
        "TOKEN_BUDGET",
        "COST_BUDGET"
      ]
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "mayMutateCapital",
        "mayMutateControls",
        "mayExecuteRepair",
        "riskReductionMustRemainAvailable"
      ],
      "properties": {
        "authority": { "const": "EVIDENCE_ONLY" },
        "mayMutateCapital": { "const": false },
        "mayMutateControls": { "const": false },
        "mayExecuteRepair": { "const": false },
        "riskReductionMustRemainAvailable": { "const": true }
      }
    },
    "sloCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sloId",
        "version",
        "category",
        "ownerId",
        "definitionSchemaVersion",
        "definitionSha256",
        "measurementSource",
        "historicalMetricBindings",
        "syntheticWindow",
        "truthLabel",
        "authority",
        "evidenceOnly"
      ],
      "properties": {
        "sloId": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "category": { "$ref": "#/$defs/sloCategory" },
        "ownerId": { "$ref": "#/$defs/identifier" },
        "definitionSchemaVersion": { "const": "slo-trend.v1" },
        "definitionSha256": { "$ref": "#/$defs/sha256" },
        "measurementSource": { "$ref": "#/$defs/measurementSource" },
        "historicalMetricBindings": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/historicalMetricBinding" }
        },
        "syntheticWindow": { "$ref": "#/$defs/syntheticWindow" },
        "truthLabel": { "const": "SYNTHETIC_ONLY" },
        "authority": { "const": "SYNTHETIC_TEST" },
        "evidenceOnly": { "const": true }
      }
    },
    "syntheticWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowId", "startMs", "endMs", "sampleCount"],
      "properties": {
        "windowId": { "$ref": "#/$defs/identifier" },
        "startMs": { "$ref": "#/$defs/utcMillis" },
        "endMs": { "$ref": "#/$defs/utcMillis" },
        "sampleCount": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "historicalMetricBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "family"],
      "properties": {
        "metricId": { "$ref": "#/$defs/identifier" },
        "family": { "$ref": "#/$defs/metricFamily" }
      }
    },
    "measurementSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metricId", "family", "statistic"],
          "properties": {
            "kind": { "const": "HISTORICAL_METRIC_STATISTIC" },
            "metricId": { "$ref": "#/$defs/identifier" },
            "family": { "$ref": "#/$defs/metricFamily" },
            "statistic": { "enum": ["P50", "P95", "P99", "COUNT", "RATE", "SUM", "UTILIZATION"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ownerId", "evidenceKind"],
          "properties": {
            "kind": { "const": "CANONICAL_OWNER_EVIDENCE" },
            "ownerId": { "$ref": "#/$defs/identifier" },
            "evidenceKind": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "historicalMetricEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "family",
        "ownerId",
        "unit",
        "statistics",
        "maximumSeriesPoints",
        "retentionWindowMs",
        "truthLabel",
        "authority",
        "evidenceOnly"
      ],
      "properties": {
        "metricId": { "$ref": "#/$defs/identifier" },
        "family": { "$ref": "#/$defs/metricFamily" },
        "ownerId": { "$ref": "#/$defs/identifier" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "statistics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": ["P50", "P95", "P99", "COUNT", "RATE", "SUM", "UTILIZATION"]
          }
        },
        "maximumSeriesPoints": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "retentionWindowMs": { "type": "integer", "minimum": 1, "maximum": 31536000000 },
        "truthLabel": { "const": "SYNTHETIC_ONLY" },
        "authority": { "const": "SYNTHETIC_TEST" },
        "evidenceOnly": { "const": true }
      }
    }
  }
}
