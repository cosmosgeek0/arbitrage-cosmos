{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmosgeek.org/schemas/i00/authorized-effect-handoff.v1.json",
  "title": "I00 authorized effect inherited handoff",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "handoffNonce",
    "actionClass",
    "authorizationId",
    "claimKey",
    "consumptionSha256",
    "riskVersion",
    "serverPreviewDigest",
    "authorizationExpiresAtUtc",
    "evidenceValidUntilUtc",
    "receiptPublicationReserveSeconds",
    "effectUid",
    "effectGid",
    "program",
    "verifier",
    "delegatedScript",
    "delegatedBootstrap",
    "delegatedEnvironment",
    "effectExecutables",
    "delegatedArgv",
    "effectDirectory",
    "helperPolicy",
    "automaticRollback",
    "writeRoots",
    "readRoots",
    "observedRoots",
    "effectOutput",
    "authorizationChain",
    "startEvidencePath",
    "startEvidenceSha256",
    "effectStartedAtUtc",
    "runner"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "AUTHORIZED_EFFECT_HANDOFF" },
    "status": { "type": "string", "const": "ACTIVE_BOUND_EFFECT" },
    "handoffNonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "actionClass": {
      "type": "string",
      "enum": [
        "OPS_BUNDLE_INSTALL",
        "SERVICE_RELEASE_SWITCH",
        "SERVICE_ROLLBACK",
        "BACKUP_CREATE",
        "ISOLATED_RESTORE",
        "SECRET_MATERIALIZATION"
      ]
    },
    "authorizationId": { "type": "string", "minLength": 1 },
    "claimKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "consumptionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "riskVersion": {
      "type": "string",
      "pattern": "^i00-deployment-risk-v1:sha256:[0-9a-f]{64}$"
    },
    "serverPreviewDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorizationExpiresAtUtc": { "type": "string", "format": "date-time" },
    "evidenceValidUntilUtc": { "type": "string", "format": "date-time" },
    "receiptPublicationReserveSeconds": {
      "type": "integer"
    },
    "effectUid": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "effectGid": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "program": { "$ref": "#/$defs/fileBinding" },
    "verifier": { "$ref": "#/$defs/fileBinding" },
    "delegatedScript": { "$ref": "#/$defs/fileBinding" },
    "delegatedBootstrap": {
      "oneOf": [
        { "type": "string", "const": "NONE" },
        { "$ref": "#/$defs/typedFileBinding" }
      ]
    },
    "delegatedEnvironment": {
      "oneOf": [
        { "type": "string", "const": "NONE" },
        { "$ref": "#/$defs/typedFileBinding" }
      ]
    },
    "delegatedArgv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "effectExecutables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fd", "binding"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "alert", "aws", "bash", "chmod", "cp", "curl", "env", "exposure",
              "getent", "gzip", "hash", "id", "mkdir", "mv", "node", "rm", "setpriv",
              "sqlite", "systemctl", "tar"
            ]
          },
          "fd": { "type": "integer" },
          "binding": { "$ref": "#/$defs/fileBinding" }
        },
        "additionalProperties": false
      }
    },
    "effectDirectory": {
      "type": "object",
      "required": ["kind", "path", "identity"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["CLAIM_TEMPORARY_DIRECTORY", "CREDENTIAL_OUTPUT_PARENT"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "identity": {
          "type": "string",
          "pattern": "^device=[0-9]+,inode=[0-9]+,mode=[0-7]+,uid=[0-9]+,gid=[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "helperPolicy": {
      "oneOf": [
        { "type": "string", "const": "NONE" },
        { "$ref": "#/$defs/helperPolicy" }
      ]
    },
    "automaticRollback": {
      "oneOf": [
        { "$ref": "#/$defs/emptyObject" },
        { "$ref": "#/$defs/automaticRollback" }
      ]
    },
    "writeRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/writeRoot" }
    },
    "readRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/readRoot" }
    },
    "observedRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/observedRoot" }
    },
    "effectOutput": {
      "oneOf": [
        { "$ref": "#/$defs/emptyObject" },
        { "$ref": "#/$defs/effectOutputPolicy" }
      ]
    },
    "startEvidencePath": { "type": "string", "pattern": "^/" },
    "startEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "effectStartedAtUtc": { "type": "string", "format": "date-time" },
    "authorizationChain": {
      "type": "object",
      "required": [
        "authorization",
        "deploymentRisk",
        "actionPreview",
        "authorizationConsumption",
        "consumptionRoot"
      ],
      "properties": {
        "authorization": { "$ref": "#/$defs/fileBinding" },
        "deploymentRisk": { "$ref": "#/$defs/fileBinding" },
        "actionPreview": { "$ref": "#/$defs/fileBinding" },
        "authorizationConsumption": { "$ref": "#/$defs/fileBinding" },
        "consumptionRoot": {
          "type": "object",
          "required": ["path", "identity"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "identity": {
              "type": "string",
              "pattern": "^device=[0-9]+,inode=[0-9]+,mode=[0-7]+,uid=[0-9]+,gid=[0-9]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "required": ["pid", "node", "source"],
      "properties": {
        "pid": { "type": "integer" },
        "node": { "$ref": "#/$defs/fileBinding" },
        "source": { "$ref": "#/$defs/fileBinding" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "emptyObject": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "effectOutputPolicy": {
      "type": "object",
      "required": ["status", "fd", "schemaVersion", "kind", "maxBytes"],
      "properties": {
        "status": { "type": "string", "const": "ARMED" },
        "fd": { "type": "integer", "const": 53 },
        "schemaVersion": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "I00_AUTHORIZED_EFFECT_OUTPUT" },
        "maxBytes": { "type": "integer", "const": 4096 }
      },
      "additionalProperties": false
    },
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "identity"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "identity": {
          "type": "string",
          "pattern": "^device=[0-9]+,inode=[0-9]+,mode=[0-7]+,size=[0-9]+,mtimeNs=-?[0-9]+,ctimeNs=-?[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "typedFileBinding": {
      "type": "object",
      "required": ["kind", "binding"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["COMMON_SHELL", "VERIFIER_SOURCE", "SANITIZED_ENV", "PROVIDER_CONFIG"]
        },
        "binding": { "$ref": "#/$defs/fileBinding" }
      },
      "additionalProperties": false
    },
    "helperPolicy": {
      "type": "object",
      "required": ["exposure", "alert"],
      "properties": {
        "exposure": {
          "type": "object",
          "required": ["program", "script", "argvShape", "timeoutMs"],
          "properties": {
            "program": { "type": "string", "const": "node" },
            "script": { "type": "string", "const": "exposure" },
            "argvShape": { "type": "string", "const": "NO_ARGS" },
            "timeoutMs": { "type": "integer", "const": 3000 }
          },
          "additionalProperties": false
        },
        "alert": {
          "type": "object",
          "required": ["program", "script", "argvShape", "timeoutMs"],
          "properties": {
            "program": { "type": "string", "const": "bash" },
            "script": { "type": "string", "const": "alert" },
            "argvShape": { "type": "string", "const": "SEVERITY_CODE_MESSAGE" },
            "timeoutMs": { "type": "integer", "const": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "automaticRollback": {
      "type": "object",
      "required": [
        "status", "handoffNonce", "script", "delegatedArgv", "recovery",
        "scriptFd", "handoffFd", "acknowledgementFd"
      ],
      "properties": {
        "status": { "type": "string", "const": "ARMED" },
        "handoffNonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "script": { "$ref": "#/$defs/fileBinding" },
        "delegatedArgv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "recovery": { "type": "string", "minLength": 1 },
        "scriptFd": { "type": "integer", "const": 35 },
        "handoffFd": { "type": "integer", "const": 36 },
        "acknowledgementFd": { "type": "integer", "const": 37 }
      },
      "additionalProperties": false
    },
    "writeRoot": {
      "type": "object",
      "required": ["name", "fd", "path", "identity"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "destinationParent", "cosmosRoot", "releasesDir",
            "currentLinkParent", "previousLinkParent", "opsStateDir",
            "backupDir", "isolatedTargetParent", "rollbackEvidenceRoot", "dataDir"
          ]
        },
        "fd": { "type": "integer" },
        "path": { "type": "string", "pattern": "^/" },
        "identity": {
          "type": "string",
          "pattern": "^device=[0-9]+,inode=[0-9]+,mode=[0-7]+,uid=[0-9]+,gid=[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "observedRoot": {
      "type": "object",
      "required": ["name", "path", "identity"],
      "properties": {
        "name": { "type": "string", "enum": ["dataDir", "backupDir"] },
        "path": { "type": "string", "pattern": "^/" },
        "identity": {
          "type": "string",
          "pattern": "^device=[0-9]+,inode=[0-9]+,mode=[0-7]+,uid=[0-9]+,gid=[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "readRoot": {
      "type": "object",
      "required": ["name", "fd", "path", "identity", "treeSha256"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "dataDir", "backupSource", "releaseSource", "automaticRollbackSource"
          ]
        },
        "fd": { "type": "integer" },
        "path": { "type": "string", "pattern": "^/" },
        "identity": { "type": "string", "minLength": 1 },
        "treeSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
