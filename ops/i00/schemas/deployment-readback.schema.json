{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.invalid/i00/deployment-readback.schema.json",
  "title": "I00 deployment truth readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["testedSha", "deployedSha", "releaseId", "schemaRevision", "configRevision", "modelRevision", "services", "origin", "tunnel", "access", "watchdog", "lastBackup", "lastRestoreDrill", "rollbackCandidate", "currentDeploymentBlocker", "observedAtUtc"],
  "properties": {
    "testedSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deployedSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "releaseId": {"type": ["string", "null"]},
    "schemaRevision": {"type": ["string", "integer"]},
    "configRevision": {"type": "string", "minLength": 1},
    "modelRevision": {"type": "string", "minLength": 1},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "state": {"enum": ["READY", "DEGRADED", "BLOCKED", "NOT_CONFIGURED", "FAILED"]},
          "source": {"enum": ["READBACK", "NOT_CONFIGURED"]}
        }
      }
    },
    "origin": {"$ref": "#/$defs/stateReadback"},
    "tunnel": {"$ref": "#/$defs/stateReadback"},
    "access": {"$ref": "#/$defs/stateReadback"},
    "watchdog": {"$ref": "#/$defs/stateReadback"},
    "lastBackup": {"type": ["object", "null"]},
    "lastRestoreDrill": {"type": ["object", "null"]},
    "rollbackCandidate": {"type": ["string", "null"]},
    "currentDeploymentBlocker": {"type": ["string", "null"]},
    "observedAtUtc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "stateReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "source": {"enum": ["READBACK", "NOT_CONFIGURED"]}
      }
    }
  }
}
