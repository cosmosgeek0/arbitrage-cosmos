{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.invalid/i00/incident-receipt.schema.json",
  "title": "I00 incident receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "incidentId", "fingerprint", "severity", "rootCause", "capitalRelevance", "firstSeenUtc", "lastSeenUtc", "status", "operatorAction", "correlationIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "INCIDENT"},
    "incidentId": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "minLength": 1},
    "severity": {"enum": ["INFO", "WARNING", "CRITICAL"]},
    "rootCause": {"type": "string", "minLength": 1},
    "capitalRelevance": {"enum": ["NONE", "POTENTIAL", "ACTIVE_EXPOSURE", "UNKNOWN"]},
    "firstSeenUtc": {"type": "string", "format": "date-time"},
    "lastSeenUtc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["OPEN", "ACKNOWLEDGED", "RESOLVED_WITH_PROOF"]},
    "operatorAction": {"type": "string", "minLength": 1},
    "correlationIds": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
