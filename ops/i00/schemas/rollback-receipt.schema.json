{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.invalid/i00/rollback-receipt.schema.json",
  "title": "I00 rollback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorizationId",
    "riskVersion",
    "serverPreviewDigest",
    "authorizationSha256",
    "riskDocumentSha256",
    "previewDocumentSha256",
    "authorizationConsumptionSha256",
    "claimKey",
    "effectRecordSha256",
    "fromSha",
    "toSha",
    "from",
    "to",
    "evidence",
    "status",
    "startedAtUtc",
    "completedAtUtc",
    "recordedAtUtc"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "ROLLBACK"},
    "authorizationId": {"type": "string", "minLength": 1},
    "riskVersion": {
      "type": "string",
      "pattern": "^i00-deployment-risk-v1:sha256:[0-9a-f]{64}$"
    },
    "serverPreviewDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorizationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "riskDocumentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previewDocumentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorizationConsumptionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claimKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effectRecordSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fromSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "toSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "from": {"$ref": "#/$defs/releaseBinding"},
    "to": {"$ref": "#/$defs/releaseBinding"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preTargetReadback", "postTargetReadback", "cloudflareBoundary", "watchdog", "databaseSchema", "backup", "recovery", "reconciliation", "authorization"],
      "properties": {
        "preTargetReadback": {"$ref": "#/$defs/evidenceReference"},
        "postTargetReadback": {"$ref": "#/$defs/evidenceReference"},
        "cloudflareBoundary": {"$ref": "#/$defs/evidenceReference"},
        "watchdog": {"$ref": "#/$defs/evidenceReference"},
        "databaseSchema": {"$ref": "#/$defs/evidenceReference"},
        "backup": {"$ref": "#/$defs/evidenceReference"},
        "recovery": {"$ref": "#/$defs/evidenceReference"},
        "reconciliation": {"$ref": "#/$defs/evidenceReference"},
        "authorization": {"$ref": "#/$defs/evidenceReference"}
      }
    },
    "status": {"const": "ROLLED_BACK_PROVED"},
    "startedAtUtc": {"type": "string", "format": "date-time"},
    "completedAtUtc": {"type": "string", "format": "date-time"},
    "recordedAtUtc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "releaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "releaseId",
        "testedSha",
        "artifactManifestSha256",
        "treeSha256",
        "identity"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "releaseId": {
          "type": "string",
          "pattern": "^i00-[0-9a-f]{40}$"
        },
        "testedSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifactManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "treeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
