{
  "note": "Least-privilege IAM policy template (§24.2/§24.4): the instance role may read EXACTLY ONE secret ARN, nothing else. Attach to the EC2 instance role at the separately owner-authorized activation step. This repository never calls AWS.",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadExactlyOneCosmosSecret",
        "Effect": "Allow",
        "Action": ["secretsmanager:GetSecretValue"],
        "Resource": "REPLACE_ME_SECRET_ARN"
      }
    ]
  }
}
