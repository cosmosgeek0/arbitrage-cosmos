# ops/live/env/cosmos-app.env.template
# Install as /etc/cosmos/cosmos-app.env  (owner root:cosmos, mode 0640).
# Consumed by cosmos-app.service via EnvironmentFile=.
#
# TEMPLATE RULES (enforced by ops/tests/test-env-templates.sh):
#   - every value here is a placeholder or a safe structural default;
#   - REPLACE_ME_* values are filled at the separately owner-authorized
#     activation step, never committed anywhere;
#   - secret VALUES never live in this repository in any form.

# Loopback-only bind (§24.2). The app must never listen on a public
# interface; Cloudflare Tunnel is the only ingress. Do not change HOST.
HOST=127.0.0.1

# TCP port the app serves on the loopback interface.
PORT=8080

# Durable state directory (SQLite ledger cosmos.db lives here). Every component
# of this normalized absolute path must be ASCII; ASCII case aliases intentionally
# share one logical lease identity.
DATA_DIR=/var/lib/cosmos/data

# Optional ICON_CACHE, LIQ_CACHE, and PROFILE_CACHE overrides must resolve
# physically inside DATA_DIR. External paths and symlink escapes are rejected;
# every DATA_DIR-relative component must be ASCII and must not alias a reserved
# owner or lease component by path or existing device/inode. The complete
# configuration is rejected before logical-root or DATA_DIR creation when any
# requested target is invalid. Omit overrides to use the canonical defaults.

# F-035: the complete production app environment lives in ONE file that the
# repo's own validator (ops/i00/bin/validate-config.mjs) accepts - a template
# that cannot pass its own validator invites divergent hand-built envs.
# Durable evidence/model/backup roots (must be distinct absolute paths).
EVIDENCE_DIR=/var/lib/cosmos/evidence
MODEL_DIR=/var/lib/cosmos/models
BACKUP_DIR=/var/backups/cosmos

# The logical lease namespace. AUTHORITATIVE CARRIER IS THE UNIT's ExecStart
# env prefix (see cosmos-app.service); this line exists so the validator can
# check the value and MUST match the unit. Never nest it with DATA_DIR.
DATA_DIR_LOGICAL_LEASE_ROOT=/run/cosmos-app/data-dir-leases

# Operator identity and release provenance (filled at activation).
CONTROL_ROOM_OPERATOR_EMAIL=REPLACE_ME_OPERATOR_EMAIL
I00_TESTED_SHA=REPLACE_ME_FULL_TESTED_SHA
I00_CONFIG_REVISION=REPLACE_ME_CONFIG_REVISION
I00_MODEL_REVISION=REPLACE_ME_MODEL_REVISION_OR_UNAVAILABLE

# Node runtime environment.
NODE_ENV=production

# The service environment is fully specified by this file; the app must not
# also read a .env from the release directory (releases are immutable).
SKIP_DOTENV=1

# Exact positive admission for canonical public Binance source startup.
# I00_DETERMINISTIC_OFFLINE_PUBLIC_SOURCES must remain absent in production.
I00_PUBLIC_SOURCE_STARTUP_EGRESS=1

# Cloudflare Access origin-side JWT validation (§24.2: origin validates the
# Access JWT itself, never trusts the tunnel alone). Team domain looks like
# <team>.cloudflareaccess.com; AUD is the Access application audience tag.
# Both come from the Cloudflare dashboard at activation time.
CF_ACCESS_TEAM_DOMAIN=REPLACE_ME_TEAM_DOMAIN
CF_ACCESS_AUD=REPLACE_ME_ACCESS_AUD_TAG

# Binance API credentials are NOT configured here and NOT configured in any
# committed file. Production delivery path: EC2 instance profile ->
# least-privilege Secrets Manager read of one exact secret ARN (see
# ops/live/aws/README.md). Fetching/injecting the real values is a
# separately owner-authorized activation step (§24.4).
# BINANCE_KEY_NAME=REPLACE_ME_IF_AUTHORIZED
# BINANCE_KEY_TYPE=HMAC
