# ops/live/env/cosmos-backup.env.template
# Install as /etc/cosmos/cosmos-backup.env  (owner root:cosmos, mode 0640).
# Consumed by backup.sh, restore.sh and restore-drill.sh via --env-file,
# and by cosmos-backup.service / cosmos-restore-drill.service.
#
# Nothing here is a secret.

# Live state directory being backed up (must match cosmos-app.env DATA_DIR).
DATA_DIR=/var/lib/cosmos/data

# Where completed backups are published. Each backup is a directory named
# by UTC stamp containing cosmos.db + manifest.json (+ evidence archives).
BACKUP_DIR=/var/backups/cosmos

# How many completed backups to keep; older ones are pruned after a
# successful new backup.
BACKUP_RETENTION_COUNT=14

# Staleness threshold for `backup.sh --verify-latest` and the watchdog's
# BACKUP_STALE alarm (§23). Keep comfortably above the backup timer cadence.
BACKUP_MAX_AGE_HOURS=26

# Authorized BACKUP_CREATE currently grants only the retained DATA_DIR read
# capability. Evidence, model, and configuration archival remains
# BLOCKED_PENDING_EXPLICIT_READ_CAPABILITY. A nonempty value is rejected before
# an authorized backup effect; /etc/cosmos is never an archive input.
EVIDENCE_PATHS=

# Direct contained staging tests may still exercise the legacy evidence archive
# path. What to do when such a staging-only EVIDENCE_PATHS entry does not exist:
#   fail (default) — the backup run fails loudly;
#   skip          — recorded as missing in the manifest, backup continues.
EVIDENCE_MISSING_POLICY=fail
