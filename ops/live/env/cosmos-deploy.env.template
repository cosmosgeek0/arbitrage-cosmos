# ops/live/env/cosmos-deploy.env.template
# Install as /etc/cosmos/cosmos-deploy.env  (owner root:root, mode 0640).
# Passed to deploy.sh / rollback.sh via --env-file.
#
# Every path/value below is a structural default, overridable per host.
# Nothing here is a secret.

# Release layout: immutable release dirs + atomic `current` symlink (§24.2).
COSMOS_ROOT=/opt/cosmos
RELEASES_DIR=/opt/cosmos/releases
CURRENT_LINK=/opt/cosmos/current
PREVIOUS_LINK=/opt/cosmos/previous

# Durable state directory (must match cosmos-app.env DATA_DIR).
DATA_DIR=/var/lib/cosmos/data

# Ops bookkeeping: deploy log, locks, frozen marker, money-readiness marker.
OPS_STATE_DIR=/var/lib/cosmos/ops

# systemd unit that runs the app.
APP_UNIT=cosmos-app.service

# Base URL for post-switch health gating — loopback only, matches the app bind.
HEALTH_BASE=http://127.0.0.1:8080

# Health paths that must answer 2xx before/after the switch (§24.3).
# /health/live and /health/ready are both served by the current runtime
# (F-027: never downgrade this gate to the liveness-only /api/health).
# trade-ready is deliberately NEVER part of the deploy gate: the cockpit must
# stay available while trade readiness is red.
READINESS_GATE_PATHS="/health/live /health/ready"
POST_SWITCH_GATE_PATHS="/health/live /health/ready"

# Seconds each gate may wait before the deploy is declared failed.
GATE_TIMEOUT_SEC=60

# Pre-switch probe: boot the candidate on a throwaway port + data dir and
# require the readiness gate to pass BEFORE the symlink switch (§24.2).
PROBE_ENABLED=1
PROBE_PORT=8091

# Command printing current exposure state: NONE | ACTIVE | AMBIGUOUS |
# RECOVERY_REQUIRED | UNKNOWN. Automation (auto-rollback) acts only on
# literal NONE; unset/failed collapses to UNKNOWN which freezes deployment.
# Wire this to the app's exposure endpoint at integration time. The value the
# I00 wrapper path force-sets (F-028; sanitize-donor-env.mjs) is:
#   EXPOSURE_CMD="/usr/bin/node /usr/local/lib/cosmos-ops/i00/bin/exposure-from-app.mjs"
EXPOSURE_CMD=

# Marker file whose presence means money readiness has been reached at least
# once; from then on there is no automatic rollback, ever (§24.2). Created
# only by the separately owner-authorized live activation, never by deploy.
MONEY_READY_MARKER=/var/lib/cosmos/ops/money-ready

# Alert hook (SEVERITY CODE MESSAGE). Default logs locally via journald.
ALERT_CMD=/usr/local/lib/cosmos-ops/i00/accepted-ops-live/bin/alert-log.sh
