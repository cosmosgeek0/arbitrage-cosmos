# ops/live/env/cosmos-watchdog.env.template
# Install as /etc/cosmos/cosmos-watchdog.env  (owner root:root, mode 0640).
# Consumed by watchdog.sh via cosmos-watchdog.service.
#
# Nothing here is a secret. If you route alerts to a webhook, the webhook
# URL belongs in the installed env file on the host — never in the repo.

# Loopback base URL of the supervised app (matches cosmos-app.env).
HEALTH_BASE=http://127.0.0.1:8080

# Health paths (§24.3). Until the L spine lands the split endpoints the
# current runtime only has /api/health; override LIVE_PATH accordingly.
LIVE_PATH=/health/live
READY_PATH=/health/ready

# Units under supervision.
APP_UNIT=cosmos-app.service
TUNNEL_UNIT=cloudflared.service

# Consecutive live-gate failures before a restart is attempted.
LIVE_FAIL_THRESHOLD=3

# Restart budget: at most MAX_RESTARTS_PER_WINDOW app restarts per
# RESTART_WINDOW_SEC. A crash loop beyond that pages the operator instead
# of hammering the box.
RESTART_WINDOW_SEC=1800
MAX_RESTARTS_PER_WINDOW=2

# Whether the watchdog may also restart the tunnel unit when it is down
# (same budget discipline). 0 = alert only.
WATCHDOG_RESTART_TUNNEL=0

# Ops bookkeeping directory (shared with deploy.sh: the watchdog reads the
# deploy lock and the deploy-frozen marker from here).
OPS_STATE_DIR=/var/lib/cosmos/ops

# Backup freshness alarm (§23 "backup stale"). Leave BACKUP_DIR empty to
# disable the check on hosts that do not run backups.
BACKUP_DIR=/var/backups/cosmos
BACKUP_MAX_AGE_HOURS=26

# Alert hook (SEVERITY CODE MESSAGE). Default logs locally via journald.
ALERT_CMD=/usr/local/lib/cosmos-ops/bin/alert-log.sh
