# ops/live/systemd/cosmos-app.service — supervised loopback-only app service.
#
# §24.2: separate supervised app and cloudflared services; app binds loopback
# only (HOST=127.0.0.1 comes from /etc/cosmos/cosmos-app.env); bounded,
# journaled logs. Secrets never appear in this unit — runtime configuration
# lives in the EnvironmentFile (root:cosmos, mode 0640), and real secret
# material is delivered by the separately authorized Secrets Manager path
# (see ops/live/aws/README.md).
#
# Install: copy to /etc/systemd/system/cosmos-app.service, then
#   systemctl daemon-reload && systemctl enable --now cosmos-app.service
# (Enabling/running units is an owner-authorized live step; never done from
# this repository's tests.)

[Unit]
Description=Cosmos trading application (loopback origin behind Cloudflare Tunnel)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=cosmos
Group=cosmos
WorkingDirectory=/opt/cosmos/current
EnvironmentFile=/etc/cosmos/cosmos-app.env
# Applied after EnvironmentFile and manager state, immediately before exec.
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE NODE_EXTRA_CA_CERTS NODE_ICU_DATA NODE_V8_COVERAGE NODE_DEBUG NODE_DEBUG_NATIVE NODE_REDIRECT_WARNINGS NODE_COMPILE_CACHE NODE_DISABLE_COMPILE_CACHE NODE_PRESERVE_SYMLINKS NODE_PRESERVE_SYMLINKS_MAIN
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_PROFILE LD_ORIGIN_PATH DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH OPENSSL_CONF OPENSSL_MODULES SSL_CERT_FILE SSL_CERT_DIR
UnsetEnvironment=NODE_TLS_REJECT_UNAUTHORIZED NODE_USE_ENV_PROXY NODE_USE_SYSTEM_CA HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY http_proxy https_proxy no_proxy all_proxy
RuntimeDirectory=cosmos-app
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
# EnvironmentFile= overrides Environment= regardless of line order. Pin this
# deployment-owned authority after systemd assembles the inherited environment.
ExecStart=/usr/bin/env DATA_DIR_LOGICAL_LEASE_ROOT=/run/cosmos-app/data-dir-leases /usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=5
# F-017: the stop budget must exceed the application's own drain budget
# (DEFAULT_DRAIN_TIMEOUT_MS = 45 s) plus its 8 s internal HTTP close deadline,
# with margin — otherwise systemd SIGKILLs mid-drain and leaves an
# untruncated WAL. 75 = 45 + 8 + margin.
TimeoutStopSec=75
KillSignal=SIGTERM

# --- filesystem/privilege hardening ---
# Do NOT add PrivatePIDs= here (F-111): the DATA_DIR lease classifies owners
# via kill(pid,0) and /proc/<pid>/stat and requires a shared PID namespace
# (see ops/live/bin/common.sh lock-owner classifier). Its absence is enforced
# by ops/tests/test-systemd-units.sh and test/opsShadow/contract.mjs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cosmos /run/cosmos-app
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
# AF_NETLINK is required: os.networkInterfaces() (server/src/systemIntegration/
# persistence/dataDirLease.ts:19,166) opens a netlink socket to resolve host
# identity for the DATA_DIR lease. Without it the service crash-loops on Linux.
# macOS does not use netlink, so no amount of local testing surfaces this.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=65536

# --- bounded, journaled logs (§24.2) ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmos-app
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
