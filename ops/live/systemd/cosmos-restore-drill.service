# ops/live/systemd/cosmos-restore-drill.service — isolated restore test.
#
# Historical timer target retained for byte/audit continuity. It is dormant
# because no production restore-drill action class exists.

[Unit]
Description=Cosmos periodic isolated restore drill
ConditionPathExists=!/
RefuseManualStart=yes

[Service]
Type=oneshot
# Part 4 #11: restore + verify of a large backup can exceed the 90 s stock
# default; 60 min bounds the drill without letting a hung run live forever.
TimeoutStartSec=3600
User=cosmos
Group=cosmos
EnvironmentFile=/etc/cosmos/cosmos-backup.env
ExecStart=/usr/local/lib/cosmos-ops/i00/accepted-ops-live/bin/restore-drill.sh --env-file /etc/cosmos/cosmos-backup.env

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/cosmos
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmos-restore-drill
