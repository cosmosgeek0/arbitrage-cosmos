{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOneExactCosmosSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "REPLACE_ME_EXACT_SECRET_ARN_WITH_SIX_CHARACTER_SUFFIX"
    },
    {
      "Sid": "DecryptOnlyForThatSecretThroughSecretsManager",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "REPLACE_ME_EXACT_KMS_KEY_ARN",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.REPLACE_ME_AWS_REGION.amazonaws.com",
          "kms:EncryptionContext:SecretARN": "REPLACE_ME_EXACT_SECRET_ARN_WITH_SIX_CHARACTER_SUFFIX"
        }
      }
    }
  ]
}
