# Drop-in for the accepted L15 cosmos-app.service. Requires systemd >=247.
# The absolute LoadCredential source is fatal when missing; no silent fallback.
[Unit]
Requires=cosmos-secrets-provider.service
After=cosmos-secrets-provider.service

[Service]
LoadCredential=app-secrets:/run/cosmos-secret-source/app-secrets.json
ExecStart=
# The base unit carries DATA_DIR_LOGICAL_LEASE_ROOT on its ExecStart because
# EnvironmentFile= outranks Environment=. Resetting ExecStart drops that pin,
# so it must be re-carried here or the app throws
# DATA_DIR_LOGICAL_LEASE_ROOT_REQUIRED at module load under NODE_ENV=production.
ExecStart=/usr/bin/env DATA_DIR_LOGICAL_LEASE_ROOT=/run/cosmos-app/data-dir-leases /usr/bin/node /usr/local/lib/cosmos-ops/i00/bin/app-entrypoint.mjs
EnvironmentFile=/etc/cosmos/cosmos-i00.env
