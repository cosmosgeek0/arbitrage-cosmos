[Unit]
Description=Cosmos exact-ARN Secrets Manager credential materialization
Wants=network-online.target
After=network-online.target
Before=cosmos-app.service

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=cosmos-secret-source
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE NODE_EXTRA_CA_CERTS NODE_ICU_DATA NODE_V8_COVERAGE NODE_DEBUG NODE_DEBUG_NATIVE NODE_REDIRECT_WARNINGS NODE_COMPILE_CACHE NODE_DISABLE_COMPILE_CACHE NODE_PRESERVE_SYMLINKS NODE_PRESERVE_SYMLINKS_MAIN
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_PROFILE LD_ORIGIN_PATH DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH OPENSSL_CONF OPENSSL_MODULES SSL_CERT_FILE SSL_CERT_DIR
UnsetEnvironment=NODE_TLS_REJECT_UNAUTHORIZED NODE_USE_ENV_PROXY NODE_USE_SYSTEM_CA HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY http_proxy https_proxy no_proxy all_proxy
# These exact documents authorize this materialization invocation. A later
# release/rollback preview binds them only as prior provider provenance.
ExecStart=/usr/bin/node REPLACE_ME_OPS_HELPER_ROOT/bin/secret-materialization.mjs --authorization /etc/cosmos/external-authorization.json --deployment-risk /var/lib/cosmos-deployment-authorization/REPLACE_ME_DEPLOYMENT_RISK_DOCUMENT.json --action-preview /var/lib/cosmos-deployment-authorization/REPLACE_ME_ACTION_PREVIEW_DOCUMENT.json --authorization-consumption-root /var/lib/cosmos-authorization-consumption
RemainAfterExit=yes
# The wrapper consumes single-use authorization before provider execution. Restart=no
# disables only systemd's automatic restart after this oneshot exits; it does not refuse
# an operator-requested start or restart. Every invocation still passes through the
# single-use authorization validator.
Restart=no
# The wrapper captures the runner streams, accepts only the fixed redacted provider
# terminal contract, and never relays raw provider or AWS output to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmos-secrets-provider
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/cosmos-secret-source
ReadWritePaths=/REPLACE_ME_EXACT_AUTHORIZATION_CONSUMPTION_PARENT
ReadWritePaths=/REPLACE_ME_EXACT_RECEIPT_PARENT
ReadWritePaths=/REPLACE_ME_EXACT_EFFECT_EVIDENCE_PARENT
ReadOnlyPaths=/var/lib/cosmos-deployment-authorization
ReadOnlyPaths=/etc/cosmos /usr/local/lib/cosmos-ops
UMask=0077

[Install]
WantedBy=multi-user.target
