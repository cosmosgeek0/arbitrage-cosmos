[Unit]
Description=Cosmos exact-ARN Secrets Manager credential materialization
Wants=network-online.target
After=network-online.target
Before=cosmos-app.service

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=cosmos-secret-source
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
Environment=AWS_EC2_METADATA_DISABLED=false
Environment=AWS_CLI=/usr/local/bin/aws
ExecStart=/usr/bin/node /usr/local/lib/cosmos-ops/i00/bin/secrets-provider.mjs --config /etc/cosmos/secrets-provider.json --output /run/cosmos-secret-source/app-secrets.json --authorization /etc/cosmos/external-authorization.json
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/cosmos-secret-source
UMask=0077

[Install]
WantedBy=multi-user.target
