        {
          "op": "replace",
          "path": ["prices", 0, "timestampUs"],
          "value": 1767268800000000
        },
        {
          "op": "replace",
          "path": ["prices", 0, "timestampLabel"],
          "value": "2026-01-01T12:00:00Z"
        }
      ]
    },
    {
