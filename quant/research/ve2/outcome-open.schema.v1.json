{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.local/schemas/ve2.outcome-open-receipt.v1.json",
  "title": "VE2 single terminal outcome-open receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "openLockId",
    "activationId",
    "manifestId",
    "manifestSha256",
    "evidenceSegmentInventorySha256",
    "state",
    "maturityAtUtc",
    "openedAtUtc",
    "maturityPassed",
    "finalManifestVerified",
    "protocolDrift",
    "priorOutcomeOpenCount",
    "outcomeOpenCount",
    "openedPaths",
    "consumerGate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ve2.outcome-open-receipt.v1"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^ve2_open_[a-f0-9]{64}$"
    },
    "openLockId": {
      "type": "string",
      "pattern": "^ve2_open_once_[a-f0-9]{64}$",
      "description": "Deterministic from manifestId alone and created with single-writer exclusive-create semantics."
    },
    "activationId": {
      "type": "string",
      "pattern": "^ve2_activation_[a-f0-9]{64}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^ve2_manifest_[a-f0-9]{64}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceSegmentInventorySha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "state": {
      "const": "TERMINAL_OUTCOME_OPENED_ONCE"
    },
    "maturityAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "openedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "maturityPassed": {
      "const": true
    },
    "finalManifestVerified": {
      "const": true
    },
    "protocolDrift": {
      "const": false
    },
    "priorOutcomeOpenCount": {
      "const": 0
    },
    "outcomeOpenCount": {
      "const": 1
    },
    "openedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^quant/research/ve2/outcome/(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "consumerGate": {
      "const": "BLOCKED_UNTIL_TERMINAL_RESULT_INDEPENDENTLY_ACCEPTED"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "TERMINAL_OUTCOME_OPENED_ONCE"
          }
        }
      },
      "then": {
        "properties": {
          "priorOutcomeOpenCount": {
            "const": 0
          },
          "outcomeOpenCount": {
            "const": 1
          },
          "maturityPassed": {
            "const": true
          }
        }
      }
    }
  ]
}
