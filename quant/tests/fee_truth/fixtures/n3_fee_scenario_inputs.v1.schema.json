{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asOfUtc": {
      "$ref": "#/$defs/utcSeconds"
    },
    "consumer": {
      "const": "N-3"
    },
    "historicalAccountActual": {
      "additionalProperties": false,
      "properties": {
        "knownness": {
          "const": "UNKNOWN"
        },
        "reasonCodes": {
          "const": [
            "CURRENT_RATE_NOT_HISTORICAL_ACTUAL"
          ]
        },
        "value": {
          "const": null
        }
      },
      "required": [
        "knownness",
        "reasonCodes",
        "value"
      ],
      "type": "object"
    },
    "inputReceiptSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "scenarios": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "baseScenarioIds": {
                  "const": []
                },
                "rateRows": {
                  "$ref": "#/$defs/accountRateRows"
                },
                "scenarioId": {
                  "const": "ACCOUNT_EFFECTIVE_SANITIZED"
                },
                "scenarioState": {
                  "enum": [
                    "READY",
                    "UNKNOWN"
                  ]
                },
                "truthState": {
                  "enum": [
                    "KNOWN",
                    "UNKNOWN"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/adverseScenario"
            },
            {
              "properties": {
                "baseScenarioIds": {
                  "const": [
                    "ACCOUNT_EFFECTIVE_SANITIZED",
                    "PUBLIC_REGULAR_NO_BNB"
                  ]
                },
                "rateRows": {
                  "$ref": "#/$defs/adverseRateRows"
                },
                "scenarioId": {
                  "const": "ADVERSE_PLUS_2_BPS_PER_SIDE_PER_FILL_LEG"
                },
                "stressRate": {
                  "const": {
                    "denominator": "5000",
                    "numerator": "1"
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "baseScenarioIds": {
                  "const": [
                    "ACCOUNT_EFFECTIVE_SANITIZED"
                  ]
                },
                "rateRows": {
                  "$ref": "#/$defs/sensitivityRateRows"
                },
                "scenarioId": {
                  "const": "BNB_OR_PROMOTION_SENSITIVITY_ONLY"
                },
                "scenarioState": {
                  "enum": [
                    "SENSITIVITY_ONLY",
                    "UNKNOWN"
                  ]
                },
                "truthState": {
                  "enum": [
                    "SENSITIVITY_ONLY",
                    "UNKNOWN"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "baseScenarioIds": {
                  "const": []
                },
                "rateRows": {
                  "$ref": "#/$defs/publicRateRows"
                },
                "scenarioId": {
                  "const": "PUBLIC_REGULAR_NO_BNB"
                },
                "scenarioState": {
                  "enum": [
                    "READY",
                    "UNKNOWN"
                  ]
                },
                "truthState": {
                  "enum": [
                    "KNOWN",
                    "UNKNOWN"
                  ]
                }
              }
            }
          ]
        }
      ],
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "N3FeeScenarioInputsV1"
    },
    "units": {
      "additionalProperties": false,
      "properties": {
        "basisPoints": {
          "const": "EXACT_RATE_FRACTION_TIMES_10000"
        },
        "exchangeFeeAssetRounding": {
          "const": "UNKNOWN"
        },
        "monetaryRounding": {
          "const": "NONE"
        },
        "rate": {
          "const": "EXACT_REDUCED_FRACTION"
        }
      },
      "required": [
        "basisPoints",
        "exchangeFeeAssetRounding",
        "monetaryRounding",
        "rate"
      ],
      "type": "object"
    },
    "unknownCostsRemainUnknown": {
      "const": true
    }
  },
  "required": [
    "asOfUtc",
    "consumer",
    "historicalAccountActual",
    "inputReceiptSha256",
    "provenance",
    "scenarios",
    "schema",
    "units",
    "unknownCostsRemainUnknown"
  ],
  "type": "object",
  "$defs": {
    "accountRateRow": {
      "allOf": [
        {
          "$ref": "#/$defs/nonAdverseRateRow"
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/primaryKnownTuple"
                },
                {
                  "properties": {
                    "truthState": {
                      "const": "ACCOUNT_CURRENT"
                    }
                  },
                  "required": [
                    "truthState"
                  ]
                }
              ]
            },
            {
              "$ref": "#/$defs/unknownTuple"
            }
          ]
        }
      ]
    },
    "accountRateRows": {
      "description": "Values must be sorted by venue, symbol, liquidity role, side, and charge basis.",
      "items": {
        "$ref": "#/$defs/accountRateRow"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "adverseScenario": {
      "additionalProperties": false,
      "properties": {
        "baseScenarioIds": {
          "$ref": "#/$defs/baseScenarioIds"
        },
        "rateRows": {
          "$ref": "#/$defs/rateRows"
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "scenarioId": {
          "$ref": "#/$defs/scenarioId"
        },
        "scenarioState": {
          "enum": [
            "READY",
            "UNKNOWN"
          ]
        },
        "stressRate": {
          "$ref": "#/$defs/exactRatio"
        },
        "truthState": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "baseScenarioIds",
        "rateRows",
        "reasonCodes",
        "scenarioId",
        "scenarioState",
        "stressRate",
        "truthState"
      ],
      "type": "object"
    },
    "adverseRateRow": {
      "allOf": [
        {
          "$ref": "#/$defs/rateRow"
        },
        {
          "required": [
            "baseScenarioId"
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/primaryKnownTuple"
                },
                {
                  "properties": {
                    "truthState": {
                      "const": "STRESS_COUNTERFACTUAL"
                    }
                  },
                  "required": [
                    "truthState"
                  ]
                }
              ]
            },
            {
              "$ref": "#/$defs/unknownTuple"
            }
          ]
        }
      ]
    },
    "adverseRateRows": {
      "description": "Values must be sorted by base scenario, venue, symbol, liquidity role, side, and charge basis.",
      "items": {
        "$ref": "#/$defs/adverseRateRow"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "baseScenarioIds": {
      "items": {
        "enum": [
          "ACCOUNT_EFFECTIVE_SANITIZED",
          "PUBLIC_REGULAR_NO_BNB"
        ]
      },
      "maxItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "component": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "knownness": {
              "const": "KNOWN"
            },
            "value": {
              "$ref": "#/$defs/exactRatio"
            }
          },
          "required": [
            "knownness",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "knownness": {
              "enum": [
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "value": {
              "const": null
            }
          },
          "required": [
            "knownness",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "components": {
      "additionalProperties": false,
      "properties": {
        "adverse": {
          "$ref": "#/$defs/component"
        },
        "discountApplication": {
          "enum": [
            "APPLIED_TO_STANDARD_ONLY",
            "NOT_APPLIED",
            "UNKNOWN"
          ]
        },
        "feeAsset": {
          "enum": [
            "BNB",
            "RECEIVED_ASSET",
            "SETTLEMENT_ASSET",
            "UNKNOWN"
          ]
        },
        "special": {
          "$ref": "#/$defs/component"
        },
        "standardAfterDiscount": {
          "$ref": "#/$defs/component"
        },
        "standardBeforeDiscount": {
          "$ref": "#/$defs/component"
        },
        "standardPayableMultiplier": {
          "$ref": "#/$defs/component"
        },
        "tax": {
          "$ref": "#/$defs/component"
        }
      },
      "required": [
        "discountApplication",
        "feeAsset",
        "special",
        "standardAfterDiscount",
        "standardBeforeDiscount",
        "standardPayableMultiplier",
        "tax"
      ],
      "type": "object"
    },
    "exactRatio": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "pattern": "^[1-9][0-9]{0,60}$",
          "type": "string"
        },
        "numerator": {
          "pattern": "^(?:0|-?[1-9][0-9]{0,60})$",
          "type": "string"
        }
      },
      "required": [
        "denominator",
        "numerator"
      ],
      "type": "object"
    },
    "nonAdverseRateRow": {
      "allOf": [
        {
          "$ref": "#/$defs/rateRow"
        },
        {
          "not": {
            "required": [
              "baseScenarioId"
            ]
          }
        }
      ]
    },
    "primaryKnownTuple": {
      "properties": {
        "effectiveBps": {
          "$ref": "#/$defs/exactRatio"
        },
        "effectiveRate": {
          "$ref": "#/$defs/exactRatio"
        },
        "knownness": {
          "const": "KNOWN"
        },
        "sensitivityEffectiveBps": {
          "type": "null"
        },
        "sensitivityEffectiveRate": {
          "type": "null"
        },
        "truthState": {
          "enum": [
            "ACCOUNT_CURRENT",
            "PUBLIC_CURRENT",
            "STRESS_COUNTERFACTUAL"
          ]
        }
      },
      "required": [
        "effectiveBps",
        "effectiveRate",
        "knownness",
        "sensitivityEffectiveBps",
        "sensitivityEffectiveRate",
        "truthState"
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "description": "Runtime validation requires 0 < validUntilUtc - observedAtUtc <= 3600 seconds.",
      "properties": {
        "captureKind": {
          "const": "OWNER_SUPPLIED_SANITIZED_CAPTURE"
        },
        "observedAtUtc": {
          "$ref": "#/$defs/utcSeconds"
        },
        "sanitizationPolicyId": {
          "const": "FEE1_STRICT_ALLOWLIST_V1"
        },
        "sources": {
          "description": "Values must be lexicographically sorted.",
          "items": {
            "enum": [
              "BINANCE_BNB_DISCOUNT_TERMS",
              "BINANCE_SPOT_ACCOUNT_COMMISSION_SCHEMA",
              "BINANCE_SPOT_COMMISSION_FAQ",
              "BINANCE_SPOT_FEE_SCHEDULE",
              "BINANCE_USDM_ACCOUNT_COMMISSION_SCHEMA",
              "BINANCE_USDM_FEE_BURN_STATUS_SCHEMA",
              "BINANCE_USDM_FEE_SCHEDULE"
            ]
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "temporalScope": {
          "const": "CURRENT_POINT_IN_TIME"
        },
        "validUntilUtc": {
          "$ref": "#/$defs/utcSeconds"
        }
      },
      "required": [
        "captureKind",
        "observedAtUtc",
        "sanitizationPolicyId",
        "sources",
        "temporalScope",
        "validUntilUtc"
      ],
      "type": "object"
    },
    "rateRow": {
      "additionalProperties": false,
      "properties": {
        "baseScenarioId": {
          "enum": [
            "ACCOUNT_EFFECTIVE_SANITIZED",
            "PUBLIC_REGULAR_NO_BNB"
          ]
        },
        "chargeBasis": {
          "enum": [
            "RECEIVED_ASSET_AMOUNT",
            "USDM_QUOTE_NOTIONAL"
          ]
        },
        "components": {
          "$ref": "#/$defs/components"
        },
        "effectiveBps": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRatio"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveRate": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRatio"
            },
            {
              "type": "null"
            }
          ]
        },
        "historicalAccountActualState": {
          "const": "HISTORICAL_ACCOUNT_ACTUAL_UNKNOWN"
        },
        "knownness": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        },
        "liquidityRole": {
          "enum": [
            "MAKER",
            "TAKER",
            "RPI"
          ]
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "routeId": {
          "maxLength": 128,
          "pattern": "^fee1\\.(?:current_account_rate|public_schedule|sensitivity_only|unknown)\\.binance_(?:spot|usdm)\\.[a-z0-9]{5,24}\\.(?:maker|taker|rpi)\\.(?:buy|sell|both)$",
          "type": "string"
        },
        "sensitivityEffectiveBps": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRatio"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitivityEffectiveRate": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRatio"
            },
            {
              "type": "null"
            }
          ]
        },
        "side": {
          "enum": [
            "BUY",
            "SELL",
            "BOTH"
          ]
        },
        "sourceFieldRefs": {
          "$ref": "#/$defs/sourceFieldRefs"
        },
        "symbol": {
          "maxLength": 24,
          "minLength": 5,
          "pattern": "^[A-Z0-9]*[A-Z][A-Z0-9]*$",
          "type": "string"
        },
        "temporalUse": {
          "enum": [
            "ADVERSE_CURRENT_RATE_COUNTERFACTUAL",
            "CURRENT_POINT_IN_TIME",
            "CURRENT_RATE_COUNTERFACTUAL"
          ]
        },
        "truthState": {
          "enum": [
            "ACCOUNT_CURRENT",
            "PUBLIC_CURRENT",
            "SENSITIVITY_ONLY",
            "STRESS_COUNTERFACTUAL",
            "UNKNOWN"
          ]
        },
        "venue": {
          "enum": [
            "BINANCE_SPOT",
            "BINANCE_USDM"
          ]
        }
      },
      "required": [
        "chargeBasis",
        "components",
        "effectiveBps",
        "effectiveRate",
        "historicalAccountActualState",
        "knownness",
        "liquidityRole",
        "reasonCodes",
        "routeId",
        "sensitivityEffectiveBps",
        "sensitivityEffectiveRate",
        "side",
        "sourceFieldRefs",
        "symbol",
        "temporalUse",
        "truthState",
        "venue"
      ],
      "type": "object"
    },
    "rateRows": {
      "description": "Values must be sorted by base scenario, venue, symbol, liquidity role, side, and charge basis.",
      "items": {
        "$ref": "#/$defs/rateRow"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "publicRateRow": {
      "allOf": [
        {
          "$ref": "#/$defs/nonAdverseRateRow"
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/primaryKnownTuple"
                },
                {
                  "properties": {
                    "truthState": {
                      "const": "PUBLIC_CURRENT"
                    }
                  },
                  "required": [
                    "truthState"
                  ]
                }
              ]
            },
            {
              "$ref": "#/$defs/unknownTuple"
            }
          ]
        }
      ]
    },
    "publicRateRows": {
      "description": "Values must be sorted by venue, symbol, liquidity role, side, and charge basis.",
      "items": {
        "$ref": "#/$defs/publicRateRow"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "reasonCodes": {
      "description": "Values must be lexicographically sorted.",
      "items": {
        "enum": [
          "AS_OF_PRECEDES_OBSERVATION",
          "BASE_RATE_UNKNOWN",
          "DISCOUNT_APPLICATION_UNKNOWN",
          "DISCOUNT_MULTIPLIER_RATE_UNKNOWN",
          "NO_RATE_ROWS",
          "RECEIPT_RATE_UNKNOWN",
          "RECEIPT_STALE",
          "SENSITIVITY_ONLY",
          "SPECIAL_RATE_UNKNOWN",
          "STANDARD_RATE_UNKNOWN",
          "TAX_RATE_UNKNOWN"
        ]
      },
      "maxItems": 11,
      "type": "array",
      "uniqueItems": true
    },
    "scenario": {
      "additionalProperties": false,
      "properties": {
        "baseScenarioIds": {
          "$ref": "#/$defs/baseScenarioIds"
        },
        "rateRows": {
          "$ref": "#/$defs/rateRows"
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "scenarioId": {
          "$ref": "#/$defs/scenarioId"
        },
        "scenarioState": {
          "enum": [
            "READY",
            "SENSITIVITY_ONLY",
            "UNKNOWN"
          ]
        },
        "truthState": {
          "enum": [
            "KNOWN",
            "SENSITIVITY_ONLY",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "baseScenarioIds",
        "rateRows",
        "reasonCodes",
        "scenarioId",
        "scenarioState",
        "truthState"
      ],
      "type": "object"
    },
    "scenarioId": {
      "enum": [
        "ACCOUNT_EFFECTIVE_SANITIZED",
        "ADVERSE_PLUS_2_BPS_PER_SIDE_PER_FILL_LEG",
        "BNB_OR_PROMOTION_SENSITIVITY_ONLY",
        "PUBLIC_REGULAR_NO_BNB"
      ]
    },
    "sensitivityRateRow": {
      "allOf": [
        {
          "$ref": "#/$defs/nonAdverseRateRow"
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/sensitivityTuple"
            },
            {
              "$ref": "#/$defs/unknownTuple"
            }
          ]
        }
      ]
    },
    "sensitivityRateRows": {
      "description": "Values must be sorted by venue, symbol, liquidity role, side, and charge basis.",
      "items": {
        "$ref": "#/$defs/sensitivityRateRow"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "sensitivityTuple": {
      "properties": {
        "effectiveBps": {
          "type": "null"
        },
        "effectiveRate": {
          "type": "null"
        },
        "knownness": {
          "const": "UNKNOWN"
        },
        "sensitivityEffectiveBps": {
          "$ref": "#/$defs/exactRatio"
        },
        "sensitivityEffectiveRate": {
          "$ref": "#/$defs/exactRatio"
        },
        "truthState": {
          "const": "SENSITIVITY_ONLY"
        }
      },
      "required": [
        "effectiveBps",
        "effectiveRate",
        "knownness",
        "sensitivityEffectiveBps",
        "sensitivityEffectiveRate",
        "truthState"
      ]
    },
    "sourceFieldRefs": {
      "description": "Values must be lexicographically sorted.",
      "items": {
        "enum": [
          "SPOT_ACCOUNT_DISCOUNT_ASSET",
          "SPOT_ACCOUNT_DISCOUNT_ENABLED_FOR_ACCOUNT",
          "SPOT_ACCOUNT_DISCOUNT_ENABLED_FOR_SYMBOL",
          "SPOT_ACCOUNT_DISCOUNT_MULTIPLIER",
          "SPOT_ACCOUNT_SPECIAL_BUYER",
          "SPOT_ACCOUNT_SPECIAL_MAKER",
          "SPOT_ACCOUNT_SPECIAL_SELLER",
          "SPOT_ACCOUNT_SPECIAL_TAKER",
          "SPOT_ACCOUNT_STANDARD_BUYER",
          "SPOT_ACCOUNT_STANDARD_MAKER",
          "SPOT_ACCOUNT_STANDARD_SELLER",
          "SPOT_ACCOUNT_STANDARD_TAKER",
          "SPOT_ACCOUNT_TAX_BUYER",
          "SPOT_ACCOUNT_TAX_MAKER",
          "SPOT_ACCOUNT_TAX_SELLER",
          "SPOT_ACCOUNT_TAX_TAKER",
          "SPOT_BNB_DISCOUNT_STANDARD_PAYABLE_MULTIPLIER",
          "SPOT_FEE_SCHEDULE_MAKER",
          "SPOT_FEE_SCHEDULE_TAKER",
          "USDM_ACCOUNT_MAKER_COMMISSION_RATE",
          "USDM_ACCOUNT_RPI_COMMISSION_RATE",
          "USDM_ACCOUNT_TAKER_COMMISSION_RATE",
          "USDM_BNB_DISCOUNT_STATUS",
          "USDM_BNB_DISCOUNT_STANDARD_PAYABLE_MULTIPLIER",
          "USDM_FEE_SCHEDULE_MAKER",
          "USDM_FEE_SCHEDULE_TAKER"
        ]
      },
      "maxItems": 26,
      "type": "array",
      "uniqueItems": true
    },
    "unknownTuple": {
      "properties": {
        "effectiveBps": {
          "type": "null"
        },
        "effectiveRate": {
          "type": "null"
        },
        "knownness": {
          "const": "UNKNOWN"
        },
        "sensitivityEffectiveBps": {
          "type": "null"
        },
        "sensitivityEffectiveRate": {
          "type": "null"
        },
        "truthState": {
          "const": "UNKNOWN"
        }
      },
      "required": [
        "effectiveBps",
        "effectiveRate",
        "knownness",
        "sensitivityEffectiveBps",
        "sensitivityEffectiveRate",
        "truthState"
      ]
    },
    "utcSeconds": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  }
}
