{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "rows": {
      "description": "Rows must be lexicographically sorted by scenarioId. Receipt consumption must also receive an expected_symbols allowlist out of payload; a syntactically valid symbol never authorizes itself.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/spotRow"
          },
          {
            "$ref": "#/$defs/usdmRow"
          }
        ]
      },
      "maxItems": 512,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sanitizationPolicyId": {
      "const": "FEE1_STRICT_ALLOWLIST_V1"
    },
    "schema": {
      "const": "FEE_TRUTH_RECEIPT"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "provenance",
    "rows",
    "sanitizationPolicyId",
    "schema",
    "version"
  ],
  "type": "object",
  "$defs": {
    "discount": {
      "oneOf": [
        {
          "$ref": "#/$defs/discountApplied"
        },
        {
          "$ref": "#/$defs/discountNotApplied"
        },
        {
          "$ref": "#/$defs/discountUnknown"
        }
      ]
    },
    "discountApplied": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "const": "APPLIED_TO_STANDARD_ONLY"
        },
        "feeAsset": {
          "const": "BNB"
        },
        "standardPayableMultiplier": {
          "$ref": "#/$defs/knownMultiplier"
        }
      },
      "required": [
        "application",
        "feeAsset",
        "standardPayableMultiplier"
      ],
      "type": "object"
    },
    "discountNotApplied": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "const": "NOT_APPLIED"
        },
        "feeAsset": {
          "enum": [
            "RECEIVED_ASSET",
            "SETTLEMENT_ASSET"
          ]
        },
        "standardPayableMultiplier": {
          "$ref": "#/$defs/oneMultiplier"
        }
      },
      "required": [
        "application",
        "feeAsset",
        "standardPayableMultiplier"
      ],
      "type": "object"
    },
    "discountUnknown": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "const": "UNKNOWN"
        },
        "feeAsset": {
          "const": "UNKNOWN"
        },
        "standardPayableMultiplier": {
          "$ref": "#/$defs/unknownRate"
        }
      },
      "required": [
        "application",
        "feeAsset",
        "standardPayableMultiplier"
      ],
      "type": "object"
    },
    "knownMultiplier": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "pattern": "^(?:0|0\\.[0-9]{1,18})$",
          "type": "string"
        },
        "state": {
          "const": "KNOWN"
        }
      },
      "required": [
        "decimal",
        "state"
      ],
      "type": "object"
    },
    "knownRate": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "$ref": "#/$defs/plainRateDecimal"
        },
        "state": {
          "const": "KNOWN"
        }
      },
      "required": [
        "decimal",
        "state"
      ],
      "type": "object"
    },
    "notApplicableRate": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "const": null
        },
        "state": {
          "const": "NOT_APPLICABLE"
        }
      },
      "required": [
        "decimal",
        "state"
      ],
      "type": "object"
    },
    "oneMultiplier": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "pattern": "^1(?:\\.0{1,18})?$",
          "type": "string"
        },
        "state": {
          "const": "KNOWN"
        }
      },
      "required": [
        "decimal",
        "state"
      ],
      "type": "object"
    },
    "plainRateDecimal": {
      "pattern": "^(?:-1(?:\\.0{1,18})?|-0\\.(?=[0-9]{1,18}$)[0-9]*[1-9][0-9]*|0|0\\.[0-9]{1,18}|1(?:\\.0{1,18})?)$",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "description": "Runtime validation requires 0 < validUntilUtc - observedAtUtc <= 3600 seconds.",
      "properties": {
        "captureKind": {
          "const": "OWNER_SUPPLIED_SANITIZED_CAPTURE"
        },
        "observedAtUtc": {
          "$ref": "#/$defs/utcSeconds"
        },
        "sources": {
          "description": "Values must be lexicographically sorted.",
          "items": {
            "enum": [
              "BINANCE_BNB_DISCOUNT_TERMS",
              "BINANCE_SPOT_ACCOUNT_COMMISSION_SCHEMA",
              "BINANCE_SPOT_COMMISSION_FAQ",
              "BINANCE_SPOT_FEE_SCHEDULE",
              "BINANCE_USDM_ACCOUNT_COMMISSION_SCHEMA",
              "BINANCE_USDM_FEE_BURN_STATUS_SCHEMA",
              "BINANCE_USDM_FEE_SCHEDULE"
            ]
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "temporalScope": {
          "const": "CURRENT_POINT_IN_TIME"
        },
        "validUntilUtc": {
          "$ref": "#/$defs/utcSeconds"
        }
      },
      "required": [
        "captureKind",
        "observedAtUtc",
        "sources",
        "temporalScope",
        "validUntilUtc"
      ],
      "type": "object"
    },
    "rate": {
      "oneOf": [
        {
          "$ref": "#/$defs/knownRate"
        },
        {
          "$ref": "#/$defs/unknownRate"
        }
      ]
    },
    "rateOrNotApplicable": {
      "oneOf": [
        {
          "$ref": "#/$defs/knownRate"
        },
        {
          "$ref": "#/$defs/unknownRate"
        },
        {
          "$ref": "#/$defs/notApplicableRate"
        }
      ]
    },
    "scenarioId": {
      "description": "Exactly fee1.<truthState.lower()>.<venue.lower()>.<symbol.lower()>.<role.lower()>.<side.lower()>; all dimensions are re-derived by the consumer.",
      "maxLength": 128,
      "pattern": "^fee1\\.(?:current_account_rate|public_schedule|sensitivity_only|unknown)\\.binance_(?:spot|usdm)\\.[a-z0-9]{5,24}\\.(?:maker|taker|rpi)\\.(?:buy|sell|both)$",
      "type": "string"
    },
    "sourceFieldRefs": {
      "description": "Values must be lexicographically sorted and must match the row venue.",
      "items": {
        "enum": [
          "SPOT_ACCOUNT_DISCOUNT_ASSET",
          "SPOT_ACCOUNT_DISCOUNT_ENABLED_FOR_ACCOUNT",
          "SPOT_ACCOUNT_DISCOUNT_ENABLED_FOR_SYMBOL",
          "SPOT_ACCOUNT_DISCOUNT_MULTIPLIER",
          "SPOT_ACCOUNT_SPECIAL_BUYER",
          "SPOT_ACCOUNT_SPECIAL_MAKER",
          "SPOT_ACCOUNT_SPECIAL_SELLER",
          "SPOT_ACCOUNT_SPECIAL_TAKER",
          "SPOT_ACCOUNT_STANDARD_BUYER",
          "SPOT_ACCOUNT_STANDARD_MAKER",
          "SPOT_ACCOUNT_STANDARD_SELLER",
          "SPOT_ACCOUNT_STANDARD_TAKER",
          "SPOT_ACCOUNT_TAX_BUYER",
          "SPOT_ACCOUNT_TAX_MAKER",
          "SPOT_ACCOUNT_TAX_SELLER",
          "SPOT_ACCOUNT_TAX_TAKER",
          "SPOT_BNB_DISCOUNT_STANDARD_PAYABLE_MULTIPLIER",
          "SPOT_FEE_SCHEDULE_MAKER",
          "SPOT_FEE_SCHEDULE_TAKER",
          "USDM_ACCOUNT_MAKER_COMMISSION_RATE",
          "USDM_ACCOUNT_RPI_COMMISSION_RATE",
          "USDM_ACCOUNT_TAKER_COMMISSION_RATE",
          "USDM_BNB_DISCOUNT_STATUS",
          "USDM_BNB_DISCOUNT_STANDARD_PAYABLE_MULTIPLIER",
          "USDM_FEE_SCHEDULE_MAKER",
          "USDM_FEE_SCHEDULE_TAKER"
        ]
      },
      "maxItems": 26,
      "type": "array",
      "uniqueItems": true
    },
    "spotDiscount": {
      "oneOf": [
        {
          "$ref": "#/$defs/discountApplied"
        },
        {
          "$ref": "#/$defs/spotDiscountNotApplied"
        },
        {
          "$ref": "#/$defs/discountUnknown"
        }
      ]
    },
    "spotDiscountNotApplied": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "const": "NOT_APPLIED"
        },
        "feeAsset": {
          "const": "RECEIVED_ASSET"
        },
        "standardPayableMultiplier": {
          "$ref": "#/$defs/oneMultiplier"
        }
      },
      "required": [
        "application",
        "feeAsset",
        "standardPayableMultiplier"
      ],
      "type": "object"
    },
    "spotRow": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "truthState": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "discount": {
                "$ref": "#/$defs/discountUnknown"
              },
              "special": {
                "$ref": "#/$defs/unknownRate"
              },
              "standard": {
                "$ref": "#/$defs/unknownRate"
              },
              "tax": {
                "$ref": "#/$defs/unknownRate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truthState": {
                "const": "CURRENT_ACCOUNT_RATE"
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "side": {
                "enum": [
                  "BUY",
                  "SELL"
                ]
              },
              "special": {
                "$ref": "#/$defs/knownRate"
              },
              "standard": {
                "$ref": "#/$defs/knownRate"
              },
              "tax": {
                "$ref": "#/$defs/knownRate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truthState": {
                "const": "PUBLIC_SCHEDULE"
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "discount": {
                "$ref": "#/$defs/spotDiscountNotApplied"
              },
              "special": {
                "$ref": "#/$defs/unknownRate"
              },
              "standard": {
                "$ref": "#/$defs/knownRate"
              },
              "tax": {
                "$ref": "#/$defs/unknownRate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truthState": {
                "const": "SENSITIVITY_ONLY"
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "standard": {
                "$ref": "#/$defs/knownRate"
              }
            }
          }
        }
      ],
      "properties": {
        "chargeBasis": {
          "const": "RECEIVED_ASSET_AMOUNT"
        },
        "discount": {
          "$ref": "#/$defs/spotDiscount"
        },
        "role": {
          "enum": [
            "MAKER",
            "TAKER"
          ]
        },
        "scenarioId": {
          "$ref": "#/$defs/scenarioId"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "sourceFieldRefs": {
          "$ref": "#/$defs/sourceFieldRefs"
        },
        "special": {
          "$ref": "#/$defs/rate"
        },
        "standard": {
          "$ref": "#/$defs/rate"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "tax": {
          "$ref": "#/$defs/rate"
        },
        "truthState": {
          "enum": [
            "CURRENT_ACCOUNT_RATE",
            "PUBLIC_SCHEDULE",
            "SENSITIVITY_ONLY",
            "UNKNOWN"
          ]
        },
        "venue": {
          "const": "BINANCE_SPOT"
        }
      },
      "required": [
        "chargeBasis",
        "discount",
        "role",
        "scenarioId",
        "side",
        "sourceFieldRefs",
        "special",
        "standard",
        "symbol",
        "tax",
        "truthState",
        "venue"
      ],
      "type": "object"
    },
    "symbol": {
      "description": "Must also be present in the caller-injected expected_symbols allowlist.",
      "maxLength": 24,
      "minLength": 5,
      "pattern": "^[A-Z0-9]*[A-Z][A-Z0-9]*$",
      "type": "string"
    },
    "unknownRate": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "const": null
        },
        "state": {
          "const": "UNKNOWN"
        }
      },
      "required": [
        "decimal",
        "state"
      ],
      "type": "object"
    },
    "usdmDiscount": {
      "oneOf": [
        {
          "$ref": "#/$defs/discountApplied"
        },
        {
          "$ref": "#/$defs/usdmDiscountNotApplied"
        },
        {
          "$ref": "#/$defs/discountUnknown"
        }
      ]
    },
    "usdmDiscountNotApplied": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "const": "NOT_APPLIED"
        },
        "feeAsset": {
          "const": "SETTLEMENT_ASSET"
        },
        "standardPayableMultiplier": {
          "$ref": "#/$defs/oneMultiplier"
        }
      },
      "required": [
        "application",
        "feeAsset",
        "standardPayableMultiplier"
      ],
      "type": "object"
    },
    "usdmRow": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "truthState": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "discount": {
                "$ref": "#/$defs/discountUnknown"
              },
              "special": {
                "$ref": "#/$defs/notApplicableRate"
              },
              "standard": {
                "$ref": "#/$defs/unknownRate"
              },
              "tax": {
                "$ref": "#/$defs/notApplicableRate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truthState": {
                "enum": [
                  "CURRENT_ACCOUNT_RATE",
                  "PUBLIC_SCHEDULE",
                  "SENSITIVITY_ONLY"
                ]
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "special": {
                "$ref": "#/$defs/notApplicableRate"
              },
              "standard": {
                "$ref": "#/$defs/knownRate"
              },
              "tax": {
                "$ref": "#/$defs/notApplicableRate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truthState": {
                "const": "PUBLIC_SCHEDULE"
              }
            },
            "required": [
              "truthState"
            ]
          },
          "then": {
            "properties": {
              "discount": {
                "$ref": "#/$defs/usdmDiscountNotApplied"
              }
            }
          }
        }
      ],
      "properties": {
        "chargeBasis": {
          "const": "USDM_QUOTE_NOTIONAL"
        },
        "discount": {
          "$ref": "#/$defs/usdmDiscount"
        },
        "role": {
          "enum": [
            "MAKER",
            "TAKER",
            "RPI"
          ]
        },
        "scenarioId": {
          "$ref": "#/$defs/scenarioId"
        },
        "side": {
          "const": "BOTH"
        },
        "sourceFieldRefs": {
          "$ref": "#/$defs/sourceFieldRefs"
        },
        "special": {
          "$ref": "#/$defs/rateOrNotApplicable"
        },
        "standard": {
          "$ref": "#/$defs/rate"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "tax": {
          "$ref": "#/$defs/rateOrNotApplicable"
        },
        "truthState": {
          "enum": [
            "CURRENT_ACCOUNT_RATE",
            "PUBLIC_SCHEDULE",
            "SENSITIVITY_ONLY",
            "UNKNOWN"
          ]
        },
        "venue": {
          "const": "BINANCE_USDM"
        }
      },
      "required": [
        "chargeBasis",
        "discount",
        "role",
        "scenarioId",
        "side",
        "sourceFieldRefs",
        "special",
        "standard",
        "symbol",
        "tax",
        "truthState",
        "venue"
      ],
      "type": "object"
    },
    "utcSeconds": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  }
}
