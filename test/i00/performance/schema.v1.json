{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "i00.local-proxy-performance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "truthClass", "runId", "createdAtUtc", "source", "host", "boundary", "load", "phases", "canonicalRestart", "uncleanRecovery", "continuity", "limitations", "slo", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "i00.local-proxy-performance.v1" },
    "truthClass": { "const": "LOCAL_PROXY_MEASURED" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,120}$" },
    "createdAtUtc": { "type": "string", "minLength": 20, "maxLength": 40 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "headSha", "treeSha", "worktreeState", "protectedOwnerDirectives", "serverBundleSha256", "harnessTreeSha256"],
      "properties": {
        "branch": { "enum": ["i00-product-assembly-20260713", "DETACHED"] },
        "headSha": { "$ref": "#/$defs/sha" },
        "treeSha": { "$ref": "#/$defs/sha" },
        "worktreeState": { "enum": ["FROZEN_WITH_HASH_PINNED_OWNER_DIRECTIVES_AND_EVIDENCE", "CLEAN_DETACHED_CANDIDATE_WITH_PACKAGED_OWNER_DIRECTIVES"] },
        "protectedOwnerDirectives": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/protectedOwnerDirective" } },
        "serverBundleSha256": { "$ref": "#/$defs/sha" },
        "harnessTreeSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprintSha256", "platform", "release", "arch", "nodeVersion", "cpuModel", "logicalCpuCount", "totalMemoryBytes"],
      "properties": {
        "fingerprintSha256": { "$ref": "#/$defs/sha" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
        "release": { "type": "string", "minLength": 1, "maxLength": 120 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 40 },
        "nodeVersion": { "type": "string", "minLength": 2, "maxLength": 40 },
        "cpuModel": { "type": "string", "minLength": 1, "maxLength": 240 },
        "logicalCpuCount": { "type": "integer", "minimum": 1 },
        "totalMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["proxyClass", "fingerprintSha256", "bindHost", "transport", "reverseProxy", "forwardedHeaders", "childEnvironment", "keyMode", "publicSourcePolicy", "forbiddenActions"],
      "properties": {
        "proxyClass": { "const": "DOCUMENTED_LOCAL_PROXY" },
        "fingerprintSha256": { "$ref": "#/$defs/sha" },
        "bindHost": { "enum": ["127.0.0.1", "::1", "localhost"] },
        "transport": { "const": "LOOPBACK_HTTP_WS" },
        "reverseProxy": { "const": "NONE" },
        "forwardedHeaders": { "const": "ABSENT" },
        "childEnvironment": { "const": "ALLOWLIST_ONLY" },
        "keyMode": { "const": "KEYLESS" },
        "publicSourcePolicy": { "const": "RUNTIME_OWNED_PUBLIC_ONLY" },
        "forbiddenActions": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 3, "maxLength": 120 } }
      }
    },
    "load": {
      "type": "object", "additionalProperties": false,
      "required": ["configuredDurationSeconds", "measuredWindowSeconds", "sampleIntervalMs", "httpTargetRps", "httpConcurrency", "webSocketClients", "focusSymbol", "phaseCount", "endpoints"],
      "properties": {
        "configuredDurationSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "measuredWindowSeconds": { "type": "number", "minimum": 0 },
        "sampleIntervalMs": { "type": "integer", "minimum": 250, "maximum": 5000 },
        "httpTargetRps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "httpConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "webSocketClients": { "type": "integer", "minimum": 1, "maximum": 8 },
        "focusSymbol": { "type": "string", "pattern": "^[A-Z0-9]{5,20}$" },
        "phaseCount": { "const": 3 },
        "endpoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpointPlan" } }
      }
    },
    "phases": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/phase" } },
    "canonicalRestart": { "$ref": "#/$defs/canonicalRestart" },
    "uncleanRecovery": { "$ref": "#/$defs/uncleanRecovery" },
    "continuity": { "$ref": "#/$defs/continuity" },
    "limitations": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/limitation" } },
    "slo": { "$ref": "#/$defs/slo" },
    "artifacts": { "$ref": "#/$defs/artifacts" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "nullableNumber": { "type": ["number", "null"] },
    "protectedOwnerDirective": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "gitStatus"],
      "properties": {
        "path": { "enum": ["I00_PRODUCT_ASSEMBLY_CONTROL_ROOM_AND_LIVE_BRINGUP.md", "IP_CONTROL.md", "IP_OPS.md", "IP_PROOF.md", "IP_RUNTIME.md"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gitStatus": { "enum": ["UNTRACKED_PROTECTED_OWNER_INPUT", "CANDIDATE_COMMITTED_VERIFIER_INPUT"] }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "min", "p50", "p95", "p99", "max", "mean"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "min": { "$ref": "#/$defs/nullableNumber" },
        "p50": { "$ref": "#/$defs/nullableNumber" },
        "p95": { "$ref": "#/$defs/nullableNumber" },
        "p99": { "$ref": "#/$defs/nullableNumber" },
        "max": { "$ref": "#/$defs/nullableNumber" },
        "mean": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "endpointPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expectedStatuses"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "expectedStatuses": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
      }
    },
    "endpointResult": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "requests", "responses", "unexpected", "errors", "bytes", "statusCounts", "latencyMs"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "requests": { "type": "integer", "minimum": 0 },
        "responses": { "type": "integer", "minimum": 0 },
        "unexpected": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "statusCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "latencyMs": { "$ref": "#/$defs/summary" }
      }
    },
    "http": {
      "type": "object", "additionalProperties": false,
      "required": ["scheduled", "skippedForConcurrency", "responses", "expectedResponses", "unexpectedResponses", "networkErrors", "responseBytes", "throughputRps", "responseBytesPerSecond", "latencyMs", "endpoints"],
      "properties": {
        "scheduled": { "type": "integer", "minimum": 0 },
        "skippedForConcurrency": { "type": "integer", "minimum": 0 },
        "responses": { "type": "integer", "minimum": 0 },
        "expectedResponses": { "type": "integer", "minimum": 0 },
        "unexpectedResponses": { "type": "integer", "minimum": 0 },
        "networkErrors": { "type": "integer", "minimum": 0 },
        "responseBytes": { "type": "integer", "minimum": 0 },
        "throughputRps": { "type": "number", "minimum": 0 },
        "responseBytesPerSecond": { "type": "number", "minimum": 0 },
        "latencyMs": { "$ref": "#/$defs/summary" },
        "endpoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpointResult" } }
      }
    },
    "focus": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "burstsAttempted", "bookMessages", "tradeMessages", "status", "reason"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9]{5,20}$" },
        "burstsAttempted": { "type": "integer", "minimum": 0 },
        "bookMessages": { "type": "integer", "minimum": 0 },
        "tradeMessages": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["MEASURED", "NOT_OBSERVED", "UNAVAILABLE"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 400 }
      }
    },
    "slowConsumer": {
      "type": "object", "additionalProperties": false,
      "required": ["attempted", "pauseDurationMs", "observedClose1013", "status", "reason"],
      "properties": {
        "attempted": { "type": "boolean" },
        "pauseDurationMs": { "type": "integer", "minimum": 0 },
        "observedClose1013": { "type": "boolean" },
        "status": { "enum": ["MEASURED", "NOT_OBSERVED", "UNAVAILABLE"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 400 }
      }
    },
    "websocket": {
      "type": "object", "additionalProperties": false,
      "required": ["clientsRequested", "clientsOpened", "openErrors", "messages", "bytes", "maxClientBufferedAmountBytes", "messageTypes", "closeCodes", "shutdownClose1012Count", "uncleanClose1006Count", "focus", "slowConsumer"],
      "properties": {
        "clientsRequested": { "type": "integer", "minimum": 1 },
        "clientsOpened": { "type": "integer", "minimum": 0 },
        "openErrors": { "type": "integer", "minimum": 0 },
        "messages": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "maxClientBufferedAmountBytes": { "type": "integer", "minimum": 0 },
        "messageTypes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "closeCodes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "shutdownClose1012Count": { "type": "integer", "minimum": 0 },
        "uncleanClose1006Count": { "type": "integer", "minimum": 0 },
        "focus": { "$ref": "#/$defs/focus" },
        "slowConsumer": { "$ref": "#/$defs/slowConsumer" }
      }
    },
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["samples", "cpuOneCorePercent", "cpuHostPercent", "rssBytes", "heapUsedBytes", "eventLoopP95Ms", "eventLoopP99Ms", "eventLoopMaxMs", "rssSlopeBytesPerHour"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "cpuOneCorePercent": { "$ref": "#/$defs/summary" },
        "cpuHostPercent": { "$ref": "#/$defs/summary" },
        "rssBytes": { "$ref": "#/$defs/summary" },
        "heapUsedBytes": { "$ref": "#/$defs/summary" },
        "eventLoopP95Ms": { "$ref": "#/$defs/summary" },
        "eventLoopP99Ms": { "$ref": "#/$defs/summary" },
        "eventLoopMaxMs": { "$ref": "#/$defs/summary" },
        "rssSlopeBytesPerHour": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "growth": {
      "type": "object", "additionalProperties": false,
      "required": ["initialBytes", "finalBytes", "maxBytes", "growthBytes"],
      "properties": {
        "initialBytes": { "type": "integer", "minimum": 0 },
        "finalBytes": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 0 },
        "growthBytes": { "type": "integer" }
      }
    },
    "integrity": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["quickCheck", "integrityCheck", "journalMode", "foreignKeyViolationCount", "userVersion", "eventCount", "bootRelease", "controlCommand", "passed"],
      "properties": {
        "quickCheck": { "type": "string", "minLength": 1, "maxLength": 160 },
        "integrityCheck": { "type": "string", "minLength": 1, "maxLength": 160 },
        "journalMode": { "const": "wal" },
        "foreignKeyViolationCount": { "type": "integer", "minimum": 0 },
        "userVersion": { "type": "integer", "minimum": 0 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "bootRelease": { "$ref": "#/$defs/bootRelease" },
        "controlCommand": { "$ref": "#/$defs/controlCommandStorage" },
        "passed": { "type": "boolean" }
      }
    },
    "bootRelease": {
      "type": "object", "additionalProperties": false,
      "required": ["rowCount", "latestGeneration", "latestTestedCommit", "latestDeployedCommit", "latestConfigRevision", "latestSchemaRevision", "latestModelRevision", "latestStartedAtMs", "latestCompletedAtMs", "latestClean", "latestBlockerCode", "allRowsClean", "cleanCompletedCount", "crashPendingCount", "crashPendingGenerations", "allRowsIdentityValid", "expectedLatestLifecycle", "latestLifecycleState", "expectedCrashPendingGenerations", "lifecycleExpectationMet", "passed"],
      "properties": {
        "rowCount": { "type": "integer", "minimum": 0 },
        "latestGeneration": { "type": ["integer", "null"], "minimum": 0 },
        "latestTestedCommit": { "type": ["string", "null"] },
        "latestDeployedCommit": { "type": ["string", "null"] },
        "latestConfigRevision": { "type": ["string", "null"] },
        "latestSchemaRevision": { "type": ["string", "null"] },
        "latestModelRevision": { "type": ["string", "null"] },
        "latestStartedAtMs": { "type": ["integer", "null"], "minimum": 0 },
        "latestCompletedAtMs": { "type": ["integer", "null"], "minimum": 0 },
        "latestClean": { "type": ["boolean", "null"] },
        "latestBlockerCode": { "type": ["string", "null"] },
        "allRowsClean": { "type": "boolean" },
        "cleanCompletedCount": { "type": "integer", "minimum": 0 },
        "crashPendingCount": { "type": "integer", "minimum": 0 },
        "crashPendingGenerations": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "allRowsIdentityValid": { "type": "boolean" },
        "expectedLatestLifecycle": { "enum": ["CLEAN_COMPLETED", "CRASH_PENDING"] },
        "latestLifecycleState": { "enum": ["CLEAN_COMPLETED", "CRASH_PENDING", "INVALID"] },
        "expectedCrashPendingGenerations": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "lifecycleExpectationMet": { "type": "boolean" },
        "passed": { "type": "boolean" }
      }
    },
    "controlCommandStorage": {
      "type": "object", "additionalProperties": false,
      "required": ["idempotencyKey", "durableReceiptObserved", "durableRejectionAuditObserved", "rejectionCode", "rejectionActorSource", "checkpointControlRevision", "checkpointControlGeneration", "passed"],
      "properties": {
        "idempotencyKey": { "type": ["string", "null"], "maxLength": 128 },
        "durableReceiptObserved": { "type": "boolean" },
        "durableRejectionAuditObserved": { "type": "boolean" },
        "rejectionCode": { "type": ["string", "null"] },
        "rejectionActorSource": { "enum": ["loopback", "cloudflare-access", null] },
        "checkpointControlRevision": { "type": ["integer", "null"], "minimum": 0 },
        "checkpointControlGeneration": { "type": ["integer", "null"], "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    },
    "fileState": {
      "type": "object", "additionalProperties": false,
      "required": ["databaseBytes", "walBytes", "shmBytes"],
      "properties": {
        "databaseBytes": { "type": "integer", "minimum": 0 },
        "walBytes": { "type": "integer", "minimum": 0 },
        "shmBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["preLaunch", "samples", "database", "wal", "shm", "integrity"],
      "properties": {
        "preLaunch": { "$ref": "#/$defs/fileState" },
        "samples": { "type": "integer", "minimum": 0 },
        "database": { "$ref": "#/$defs/growth" },
        "wal": { "$ref": "#/$defs/growth" },
        "shm": { "$ref": "#/$defs/growth" },
        "integrity": { "$ref": "#/$defs/integrity" }
      }
    },
    "serviceReadinessWaiver": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "mode", "reason", "owner", "expiresAt", "status"],
      "properties": {
        "id": { "const": "READINESS-CLUSTER-001-Q-INFERENCE" },
        "scope": { "const": "KEYLESS_PUBLIC_DATA_VALIDATE_ONLY" },
        "mode": { "const": "VALIDATE_ONLY" },
        "reason": { "const": "Q_PRODUCTION_TRANSPORT_NOT_CONFIGURED" },
        "owner": { "const": "cosmosgeek" },
        "expiresAt": { "const": "2026-10-18T00:00:00Z" },
        "status": { "enum": ["VALID", "EXPIRED"] }
      }
    },
    "serviceReadinessDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "expected", "observed", "requiredForServiceReadiness", "excludedFromServiceReadiness", "waiver"],
      "properties": {
        "basis": { "enum": ["PUBLIC_DATA", "VALIDATE_ONLY_EXECUTOR", "PERSISTENCE", "MANAGED_LIFECYCLE"] },
        "expected": { "const": true },
        "observed": { "const": true },
        "requiredForServiceReadiness": { "type": "boolean" },
        "excludedFromServiceReadiness": { "type": "boolean" },
        "waiver": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/serviceReadinessWaiver" }] }
      }
    },
    "managedInventoryComponentEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "componentId", "componentProjectionIndex", "serviceReadiness"],
      "properties": {
        "source": { "const": "PRODUCT_RUNTIME_COMPONENT_PROJECTION" },
        "componentId": { "type": "string", "minLength": 3, "maxLength": 120 },
        "componentProjectionIndex": { "type": "integer", "minimum": 0, "maximum": 13 },
        "serviceReadiness": { "$ref": "#/$defs/serviceReadinessDisposition" }
      }
    },
    "managedInventoryOwnerEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "ownerId", "truthLabel"],
      "properties": {
        "source": { "const": "PRODUCT_RUNTIME_OWNER_PROJECTION" },
        "ownerId": { "const": "productIntegration.incident-router" },
        "truthLabel": { "const": "BUILT_AND_TESTED" }
      }
    },
    "managedInventoryEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/managedInventoryComponentEvidence" },
        { "$ref": "#/$defs/managedInventoryOwnerEvidence" }
      ]
    },
    "managedInventoryEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "owner", "canonicalComponentIds", "inventoryState", "evidence", "reasonCode"],
      "properties": {
        "identity": { "type": "string", "minLength": 3, "maxLength": 120 },
        "owner": { "type": "string", "minLength": 3, "maxLength": 200 },
        "canonicalComponentIds": { "type": "array", "maxItems": 14, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 120 } },
        "inventoryState": { "enum": ["EVIDENCE_PRESENT", "OWNER_GATED", "NOT_CONFIGURED", "MISSING"] },
        "evidence": { "type": ["array", "null"], "maxItems": 14, "items": { "$ref": "#/$defs/managedInventoryEvidence" } },
        "reasonCode": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "managedInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "expectedIdentityCount", "mappedIdentityCount", "evidencePresentCount", "ownerGatedCount", "notConfiguredCount", "missingCount", "canonicalComponentCount", "referencedCanonicalComponentCount", "observedCanonicalComponentCount", "entries"],
      "properties": {
        "schemaVersion": { "const": "i00-managed-inventory.v1" },
        "expectedIdentityCount": { "const": 33 },
        "mappedIdentityCount": { "type": "integer", "minimum": 0, "maximum": 33 },
        "evidencePresentCount": { "type": "integer", "minimum": 0, "maximum": 33 },
        "ownerGatedCount": { "type": "integer", "minimum": 0, "maximum": 33 },
        "notConfiguredCount": { "type": "integer", "minimum": 0, "maximum": 33 },
        "missingCount": { "type": "integer", "minimum": 0, "maximum": 33 },
        "canonicalComponentCount": { "const": 14 },
        "referencedCanonicalComponentCount": { "const": 14 },
        "observedCanonicalComponentCount": { "const": 14 },
        "entries": { "type": "array", "minItems": 33, "maxItems": 33, "items": { "$ref": "#/$defs/managedInventoryEntry" } }
      }
    },
    "canonicalComponentEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "owner", "observedLifecycle", "capability", "blocker"],
      "properties": {
        "componentId": { "type": "string", "minLength": 3, "maxLength": 120 },
        "owner": { "type": "string", "minLength": 3, "maxLength": 200 },
        "observedLifecycle": { "type": "string", "minLength": 3, "maxLength": 80 },
        "capability": { "type": "string", "minLength": 3, "maxLength": 80 },
        "blocker": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "productControlEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["controlId", "backendCommandId", "wiringState", "owner", "authority", "disabledReason"],
      "properties": {
        "controlId": { "type": "string", "minLength": 3, "maxLength": 160 },
        "backendCommandId": { "type": "string", "minLength": 3, "maxLength": 100 },
        "wiringState": { "type": "string", "minLength": 3, "maxLength": 200 },
        "owner": { "type": "string", "minLength": 3, "maxLength": 200 },
        "authority": { "type": "string", "minLength": 3, "maxLength": 120 },
        "disabledReason": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "capturedAtUtc", "liveStatus", "readyStatus", "readyClassification", "tradeReadyStatus", "tradeReadyClassification", "healthSemanticsValid", "legacyHealthStatus", "stateStatus", "stateNowMs", "eventsCountStatus", "eventsCount", "basisStatus", "basisLastBookTs", "basisLastMarkTs", "volumeStatus", "volumeLastBookTs", "volumeLastTradeTs", "volumeTradeMessages", "productSupervisorStatus", "productRevision", "runtimeGeneration", "controlGeneration", "testedCommitProjection", "deployedCommitProjection", "configRevisionProjection", "schemaRevisionProjection", "modelRevisionProjection", "deploymentFrozenProjection", "exposureStateProjection", "ambiguityStateProjection", "recoveryStateProjection", "opsInterlockState", "opsInterlockBlocksNewEntries", "opsExternalActionAuthorization", "reconciliationStatus", "reconciliationBlocksNewExposure", "reconciliationReasonCodes", "restartControlWiringState", "restartControlRevision", "managedInventory", "canonicalComponents", "productControls", "canonicalRuntimeEvidenceValid", "opsProjectionValid", "bootRevisionProjectionValid", "qComponentPresent", "qAdvisoryAction", "qTruthLabel", "qCapability", "qAuthority", "qCapitalRelevance", "qControlCount", "tradeReadyProjection", "qProjectionValid", "contentSha256"],
      "properties": {
        "label": { "enum": ["START", "END"] },
        "capturedAtUtc": { "type": "string", "minLength": 20, "maxLength": 40 },
        "liveStatus": { "const": 200 },
        "readyStatus": { "const": 503 },
        "readyClassification": { "const": "HONEST_NOT_READY_503" },
        "tradeReadyStatus": { "const": 503 },
        "tradeReadyClassification": { "const": "HONEST_NOT_READY_503" },
        "healthSemanticsValid": { "type": "boolean" },
        "legacyHealthStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
        "stateStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
        "stateNowMs": { "type": ["integer", "null"], "minimum": 0 },
        "eventsCountStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
        "eventsCount": { "type": ["integer", "null"], "minimum": 0 },
        "basisStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
        "basisLastBookTs": { "type": ["integer", "null"], "minimum": 0 },
        "basisLastMarkTs": { "type": ["integer", "null"], "minimum": 0 },
        "volumeStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
        "volumeLastBookTs": { "type": ["integer", "null"], "minimum": 0 },
        "volumeLastTradeTs": { "type": ["integer", "null"], "minimum": 0 },
        "volumeTradeMessages": { "type": ["integer", "null"], "minimum": 0 },
        "productSupervisorStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
        "productRevision": { "type": ["string", "null"] },
